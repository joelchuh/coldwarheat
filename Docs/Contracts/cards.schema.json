{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:coldwarheat:contract:cards:1",
  "title": "cards",
  "description": "卡牌定义与效果绑定契约v1：印刷事实、类型和参数引用；效果代码仅通过显式注册表绑定。",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "dataset_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)*$"
    },
    "content_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "ruleset_id": {
      "type": "string",
      "pattern": "^ruleset\\.[a-z][a-z0-9_]*(\\.[a-z0-9_]+)*$"
    },
    "scope": {
      "enum": [
        "fixture",
        "release-candidate"
      ]
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "source_catalog": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": [
              "string",
              "null"
            ]
          },
          "edition": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "url",
          "edition",
          "description"
        ]
      },
      "minItems": 1
    },
    "cards": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^card\\.[a-z][a-z0-9_]*(\\.[a-z0-9_]+)*$"
          },
          "printed_number": {
            "type": "integer",
            "minimum": 1
          },
          "name_key": {
            "type": "string",
            "minLength": 1
          },
          "rules_text_key": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "Event",
              "Scoring",
              "China"
            ]
          },
          "printed_ops": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1,
            "maximum": 4
          },
          "affiliation": {
            "enum": [
              "US",
              "USSR",
              "Neutral",
              "None"
            ]
          },
          "era": {
            "enum": [
              "Early",
              "Mid",
              "Late",
              null
            ]
          },
          "deck_entry": {
            "enum": [
              "EraDeck",
              "SpecialChina"
            ]
          },
          "remove_after_resolved_event": {
            "type": "boolean"
          },
          "display_persistent_reminder": {
            "type": "boolean"
          },
          "scoring_region_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^region\\.[a-z][a-z0-9_]*(\\.[a-z0-9_]+)*$"
              },
              {
                "type": "null"
              }
            ]
          },
          "effect_binding": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "effect_id": {
                    "type": "string",
                    "pattern": "^effect\\.[a-z][a-z0-9_]*(\\.[a-z0-9_]+)*$"
                  },
                  "contract_version": {
                    "type": "string",
                    "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
                  },
                  "parameter_refs": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "dataset_id": {
                          "type": "string",
                          "minLength": 1
                        },
                        "json_pointer": {
                          "type": "string",
                          "pattern": "^(/([^~/]|~0|~1)*)*$"
                        }
                      },
                      "required": [
                        "dataset_id",
                        "json_pointer"
                      ]
                    },
                    "minItems": 0
                  }
                },
                "required": [
                  "effect_id",
                  "contract_version",
                  "parameter_refs"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "source_refs": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "source_id": {
                  "type": "string",
                  "minLength": 1
                },
                "locator": {
                  "type": "string",
                  "minLength": 1
                },
                "verification": {
                  "enum": [
                    "Verified",
                    "Pending",
                    "Fixture"
                  ]
                }
              },
              "required": [
                "source_id",
                "locator",
                "verification"
              ]
            },
            "minItems": 1,
            "description": "逐项资料定位；Fixture不可作为正式规则证据。"
          }
        },
        "required": [
          "id",
          "printed_number",
          "name_key",
          "rules_text_key",
          "kind",
          "printed_ops",
          "affiliation",
          "era",
          "deck_entry",
          "remove_after_resolved_event",
          "display_persistent_reminder",
          "scoring_region_id",
          "effect_binding",
          "source_refs"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "Scoring"
                }
              }
            },
            "then": {
              "properties": {
                "printed_ops": {
                  "type": "null"
                },
                "affiliation": {
                  "const": "None"
                },
                "era": {
                  "enum": [
                    "Early",
                    "Mid",
                    "Late"
                  ]
                },
                "deck_entry": {
                  "const": "EraDeck"
                },
                "scoring_region_id": {
                  "type": "string",
                  "pattern": "^region\\.[a-z][a-z0-9_]*(\\.[a-z0-9_]+)*$"
                },
                "effect_binding": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "effect_id": {
                      "type": "string",
                      "pattern": "^effect\\.[a-z][a-z0-9_]*(\\.[a-z0-9_]+)*$"
                    },
                    "contract_version": {
                      "type": "string",
                      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
                    },
                    "parameter_refs": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "dataset_id": {
                            "type": "string",
                            "minLength": 1
                          },
                          "json_pointer": {
                            "type": "string",
                            "pattern": "^(/([^~/]|~0|~1)*)*$"
                          }
                        },
                        "required": [
                          "dataset_id",
                          "json_pointer"
                        ]
                      },
                      "minItems": 0
                    }
                  },
                  "required": [
                    "effect_id",
                    "contract_version",
                    "parameter_refs"
                  ]
                },
                "display_persistent_reminder": {
                  "const": false
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "China"
                }
              }
            },
            "then": {
              "properties": {
                "printed_ops": {
                  "type": "integer"
                },
                "affiliation": {
                  "const": "None"
                },
                "era": {
                  "type": "null"
                },
                "deck_entry": {
                  "const": "SpecialChina"
                },
                "scoring_region_id": {
                  "type": "null"
                },
                "effect_binding": {
                  "type": "null"
                },
                "remove_after_resolved_event": {
                  "const": false
                },
                "display_persistent_reminder": {
                  "const": false
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "Event"
                }
              }
            },
            "then": {
              "properties": {
                "printed_ops": {
                  "type": "integer"
                },
                "affiliation": {
                  "enum": [
                    "US",
                    "USSR",
                    "Neutral"
                  ]
                },
                "era": {
                  "enum": [
                    "Early",
                    "Mid",
                    "Late"
                  ]
                },
                "deck_entry": {
                  "const": "EraDeck"
                },
                "scoring_region_id": {
                  "type": "null"
                },
                "effect_binding": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "effect_id": {
                      "type": "string",
                      "pattern": "^effect\\.[a-z][a-z0-9_]*(\\.[a-z0-9_]+)*$"
                    },
                    "contract_version": {
                      "type": "string",
                      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
                    },
                    "parameter_refs": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "dataset_id": {
                            "type": "string",
                            "minLength": 1
                          },
                          "json_pointer": {
                            "type": "string",
                            "pattern": "^(/([^~/]|~0|~1)*)*$"
                          }
                        },
                        "required": [
                          "dataset_id",
                          "json_pointer"
                        ]
                      },
                      "minItems": 0
                    }
                  },
                  "required": [
                    "effect_id",
                    "contract_version",
                    "parameter_refs"
                  ]
                }
              }
            }
          }
        ]
      },
      "minItems": 1
    },
    "effect_contracts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "effect_id": {
            "type": "string",
            "pattern": "^effect\\.[a-z][a-z0-9_]*(\\.[a-z0-9_]+)*$"
          },
          "contract_version": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "handler_key": {
            "type": "string",
            "minLength": 1
          },
          "implementation_status": {
            "enum": [
              "planned",
              "implemented"
            ]
          },
          "parameter_schema_contract_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "source_refs": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "source_id": {
                  "type": "string",
                  "minLength": 1
                },
                "locator": {
                  "type": "string",
                  "minLength": 1
                },
                "verification": {
                  "enum": [
                    "Verified",
                    "Pending",
                    "Fixture"
                  ]
                }
              },
              "required": [
                "source_id",
                "locator",
                "verification"
              ]
            },
            "minItems": 1,
            "description": "逐项资料定位；Fixture不可作为正式规则证据。"
          }
        },
        "required": [
          "effect_id",
          "contract_version",
          "description",
          "handler_key",
          "implementation_status",
          "parameter_schema_contract_ids",
          "source_refs"
        ]
      },
      "minItems": 0
    }
  },
  "required": [
    "schema_version",
    "dataset_id",
    "content_version",
    "ruleset_id",
    "scope",
    "description",
    "source_catalog",
    "cards",
    "effect_contracts"
  ]
}
