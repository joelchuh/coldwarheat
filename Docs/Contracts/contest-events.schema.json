        "cards"
      ],
      "properties": {
        "military": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "dataset_id",
            "json_pointer"
          ],
          "properties": {
            "dataset_id": {
              "const": "rules.deluxe2015.military-operations"
            },
            "json_pointer": {
              "const": ""
            }
          }
        },
        "defcon": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "dataset_id",
            "json_pointer"
          ],
          "properties": {
