              "const": "rules.deluxe2015.defcon"
            },
            "json_pointer": {
              "const": ""
            }
          }
        },
        "victory": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "dataset_id",
            "json_pointer"
          ],
          "properties": {
            "dataset_id": {
              "const": "rules.deluxe2015.victory"
            },
            "json_pointer": {
              "const": ""
            }
          }
        },
        "region_scoring": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "dataset_id",
            "json_pointer"
          ],
          "properties": {
