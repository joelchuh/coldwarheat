              "const": "map.deluxe2015.world"
            },
            "json_pointer": {
              "const": ""
            }
          }
        },
        "standard_die": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "dataset_id",
            "json_pointer"
          ],
          "properties": {
            "dataset_id": {
              "const": "rules.deluxe2015.standard-dice"
            },
            "json_pointer": {
              "const": "/definitions/standard_d6"
            }
          }
        },
        "cards": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "dataset_id",
            "json_pointer"
          ],
          "properties": {
            "dataset_id": {
              "const": "cards.deluxe2015.definitions"
            },
            "json_pointer": {
              "const": "/cards"
            }
          }
        }
      }
    },
    "context_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "roles",
        "source_authorization",
        "complete_snapshot",
        "preflight",
        "unknown_relevant_interference",
        "known_irrelevant_effects",
        "invalid_running_state",
        "integer_arithmetic"
      ],
      "properties": {
        "roles": {
          "const": "DistinctRootPhasingPlayerCardPlayerEffectControllerAndDecisionOwner"
        },
        "source_authorization": {
          "const": "TrustedRegisteredSourceOnlyNoNewExternalCardAuthorization"
        },
        "complete_snapshot": {
          "const": "ValidateExactCountryCoverageAndRuleVersionBeforeRoll"
        },
        "preflight": {
          "const": "ValidateContextStateAllRelevantEffectsAndCompleteVpBatchBeforeRandom"
        },
        "unknown_relevant_interference": {
          "const": "RequiresRulingBeforeRandomOrMutation"
        },
        "known_irrelevant_effects": {
          "const": "ExcludeByVerifiedScopeWithoutConsuming"
        },
        "invalid_running_state": {
          "const": "RejectDefconAtNuclearOrAlreadyWinningVpOrMalformedState"
        },
        "integer_arithmetic": {
          "const": "CheckedNonnegativeInfluenceAndMilitaryIntegersNoSilentClamp"
        }
      }
    },
    "contest_outcome_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type_name",
        "ownership",
        "variants",
        "evidence",
        "vp_batch",
        "victory_checkpoint",
        "europe_control",
        "final_disposition",
        "root_slot"
      ],
      "properties": {
        "type_name": {
          "const": "ContestOutcome"
        },
        "ownership": {
          "const": "AuthorityGeneratedImmutable"
        },
        "variants": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "prefixItems": [
            {
              "const": "NoAward"
            },
            {
              "const": "Winner"
            },
            {
              "const": "Tie"
            }
          ],
          "items": false
        },
        "evidence": {
          "const": "VersionBoundMetricSnapshotAndSourceContext"
        },
        "vp_batch": {
          "const": "OneCompleteSemanticEventBatch"
        },
        "victory_checkpoint": {
          "const": "VpBatchClosedBeforeAnyOptionalDefconDecision"
        },
        "europe_control": {
          "const": "SummitBonusOnlyNoScoringOrAutomaticEuropeVictory"
        },
        "final_disposition": {
          "const": "SharedCardDispositionAfterFinalContinuationOrTerminal"
        },
        "root_slot": {
          "const": "NoNewRootSlot"
        }
      }
    },
    "receipt_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type_name",
        "draw_order",
        "request_binding",
        "snapshot_binding",
        "commit_boundary",
        "initial_failure",
        "later_choice_failure",
        "retry",
        "conflicting_retry",
        "continuation_binding",
        "finished"
      ],
      "properties": {
        "type_name": {
          "const": "PairedDiceContestReceipt"
        },
        "draw_order": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "prefixItems": [
            {
              "const": "US"
            },
            {
              "const": "USSR"
            }
          ],
          "items": false
        },
        "request_binding": {
          "const": "CanonicalOriginalRequestDigestAndSourceFrame"
        },
        "snapshot_binding": {
          "const": "OriginalStateVersionRulesetVersionAndDataDigest"
        },
        "commit_boundary": {
          "const": "BothRawDiceDerivedOutcomeVpBatchRngPositionAndContinuationAtomic"
        },
        "initial_failure": {
          "const": "RollbackAllUncommittedStateAndRng"
        },
        "later_choice_failure": {
          "const": "PreserveCommittedContestReceiptAndVpNoReroll"
        },
        "retry": {
          "const": "ReturnOriginalAcceptedReceiptBeforeRecomputingCurrentFacts"
        },
        "conflicting_retry": {
          "const": "RejectSameResolutionIdWithDifferentOriginalRequestDigest"
        },
        "continuation_binding": {
          "const": "WinnerDecisionIdRevisionAndCommittedReceiptDigest"
        },
        "finished": {
          "const": "AbsorbingNoNewDecisionOrParentSteps"
        }
      }
    },
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "arms_race",
        "summit"
      ],
      "properties": {
        "arms_race": {
          "$ref": "#/$defs/arms_race"
        },
        "summit": {
          "$ref": "#/$defs/summit"
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:coldwarheat:contract:contest-events:1",
  "title": "军备竞赛与峰会：分离根责任/事件控制/胜者选择，实际地图双骰比较，耐久结果收据与可选DEFCON继续；军事>5待裁定，运行待实现。",
  "description": "严格静态参数契约及未来权威输入/结果/收据/决定形状；关系不变量由同版本具名校验器完成，Schema不是运行实现。",
  "$defs": {
    "initial_input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command_id",
        "context",
        "state",
        "evidence"
      ],
      "properties": {
        "command_id": {
          "type": "string",
          "minLength": 1
        },
        "context": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "root_action_id",
            "frame_id",
            "resolution_id",
            "source_card_id",
            "source_effect_id",
            "root_phasing_player",
            "card_player",
            "effect_controller",
            "scope",
            "source_authorization",
            "ruleset_id",
            "ruleset_version",
            "data_digest",
            "expected_state_version",
            "original_request_digest"
          ],
          "properties": {
            "root_action_id": {
              "type": "string",
              "minLength": 1
            },
            "frame_id": {
              "type": "string",
              "minLength": 1
            },
            "resolution_id": {
              "type": "string",
              "minLength": 1
            },
            "source_card_id": {
              "enum": [
                "card.arms_race",
                "card.summit"
              ]
            },
            "source_effect_id": {
              "enum": [
                "effect.arms_race",
                "effect.summit"
              ]
            },
            "root_phasing_player": {
              "enum": [
                "US",
                "USSR"
              ]
            },
            "card_player": {
              "enum": [
                "US",
                "USSR"
              ]
            },
            "effect_controller": {
              "enum": [
                "US",
                "USSR"
              ]
            },
            "scope": {
              "enum": [
                "RootAction",
                "Headline",
                "VerifiedNested"
              ]
            },
            "source_authorization": {
              "enum": [
                "VerifiedInternal",
                "Unknown"
              ]
            },
            "ruleset_id": {
              "const": "ruleset.deluxe2015"
            },
            "ruleset_version": {
              "const": "deluxe-2015"
            },
            "data_digest": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "expected_state_version": {
              "type": "integer",
              "minimum": 0
            },
            "original_request_digest": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        },
        "state": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state_version",
            "defcon",
            "signed_vp",
            "military_earned",
            "countries",
            "status",
            "result_winner",
            "rng_cursor",
            "formosan_active",
            "shuttle_active",
            "nuclear_subs_active",
            "card_zone"
          ],
          "properties": {
            "state_version": {
              "type": "integer",
              "minimum": 0
            },
            "defcon": {
              "type": "integer",
              "minimum": 1
            },
            "signed_vp": {
              "type": "integer"
            },
            "military_earned": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "US",
                "USSR"
              ],
              "properties": {
                "US": {
                  "type": "integer",
                  "minimum": 0
                },
                "USSR": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            },
            "countries": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "country_id",
                  "influence"
                ],
                "properties": {
                  "country_id": {
                    "type": "string",
                    "pattern": "^country\\.[a-z0-9_]+$"
                  },
                  "influence": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "US",
                      "USSR"
                    ],
                    "properties": {
                      "US": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "USSR": {
                        "type": "integer",
                        "minimum": 0
                      }
                    }
                  }
                }
              }
            },
            "status": {
              "enum": [
                "Running",
                "Finished"
              ]
            },
            "result_winner": {
              "enum": [
                "US",
                "USSR",
                null
              ]
            },
            "rng_cursor": {
              "type": "integer",
              "minimum": 0
            },
            "formosan_active": {
              "type": "boolean"
            },
            "shuttle_active": {
              "type": "boolean"
            },
            "nuclear_subs_active": {
              "type": "boolean"
            },
            "card_zone": {
              "const": "InResolution"
            }
          }
        },
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "context_revision_matches",
            "effects_complete",
            "all_vp_providers_known",
            "unknown_relevant_interference",
            "same_data_binding"
          ],
          "properties": {
            "context_revision_matches": {
              "type": "boolean"
            },
            "effects_complete": {
              "type": "boolean"
            },
            "all_vp_providers_known": {
              "type": "boolean"
            },
            "unknown_relevant_interference": {
              "type": "boolean"
            },
            "same_data_binding": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "contest_outcome": {
      "oneOf": [
        {
          "$ref": "#/$defs/arms_outcome"
        },
        {
          "$ref": "#/$defs/summit_outcome"
        }
      ]
    },
    "paired_receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receipt_id",
        "original_request_digest",
        "source_frame_id",
        "root_action_id",
        "root_phasing_player",
        "ruleset_id",
        "ruleset_version",
        "data_digest",
        "source_state_version",
        "committed_state_version",
        "rng_cursor_before",
        "rng_cursor_after",
        "contest_outcome",
        "vp_batch_id",
        "signed_vp_before",
        "signed_vp_after",
        "defcon_at_commit",
        "result_winner",
        "next_step",
        "decision",
        "receipt_digest",
        "source_card_id",
        "source_effect_id",
        "card_player",
        "effect_controller",
        "source_scope"
      ],
      "properties": {
        "receipt_id": {
          "type": "string",
          "minLength": 1
        },
        "original_request_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "source_frame_id": {
          "type": "string",
          "minLength": 1
        },
        "root_action_id": {
          "type": "string",
          "minLength": 1
        },
        "root_phasing_player": {
          "enum": [
            "US",
            "USSR"
          ]
        },
        "ruleset_id": {
          "const": "ruleset.deluxe2015"
        },
        "ruleset_version": {
          "const": "deluxe-2015"
        },
        "data_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "source_state_version": {
          "type": "integer",
          "minimum": 0
        },
        "committed_state_version": {
          "type": "integer",
          "minimum": 0
        },
        "rng_cursor_before": {
          "type": "integer",
          "minimum": 0
        },
        "rng_cursor_after": {
          "type": "integer",
          "minimum": 0
        },
        "contest_outcome": {
          "$ref": "#/$defs/summit_outcome"
        },
        "vp_batch_id": {
          "type": "string",
          "minLength": 1
        },
        "signed_vp_before": {
          "type": "integer"
        },
        "signed_vp_after": {
          "type": "integer"
        },
        "defcon_at_commit": {
          "type": "integer",
          "minimum": 1
        },
        "result_winner": {
          "enum": [
            "US",
            "USSR",
            null
          ]
        },
        "next_step": {
          "enum": [
            "Complete",
            "AwaitDefcon",
            "Finished"
          ]
        },
        "decision": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "decision_id",
                "revision",
                "owner"
              ],
              "properties": {
                "decision_id": {
                  "type": "string",
                  "minLength": 1
                },
                "revision": {
                  "type": "integer",
                  "minimum": 0
                },
                "owner": {
                  "enum": [
                    "US",
                    "USSR"
                  ]
                }
              }
            }
          ]
        },
        "receipt_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "source_card_id": {
          "const": "card.summit"
        },
        "source_effect_id": {
          "const": "effect.summit"
        },
        "card_player": {
          "enum": [
            "US",
            "USSR"
          ]
        },
        "effect_controller": {
          "enum": [
            "US",
            "USSR"
          ]
        },
        "source_scope": {
          "enum": [
            "RootAction",
            "Headline",
            "VerifiedNested"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "next_step": {
                "const": "AwaitDefcon"
              }
            }
          },
          "then": {
            "properties": {
              "decision": {
                "not": {
                  "type": "null"
                }
              },
              "result_winner": {
                "const": null
              },
              "contest_outcome": {
                "properties": {
                  "result": {
                    "const": "Winner"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "next_step": {
                "enum": [
                  "Complete",
                  "Finished"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "decision": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "next_step": {
                "const": "Finished"
              }
            }
          },
          "then": {
            "properties": {
              "result_winner": {
                "enum": [
                  "US",
                  "USSR"
                ]
              }
            }
          }
        }
      ]
    },
    "defcon_response": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command_id",
        "decision_id",
        "decision_revision",
        "expected_state_version",
        "submitted_by",
        "choice"
      ],
      "properties": {
        "command_id": {
          "type": "string",
          "minLength": 1
        },
        "decision_id": {
          "type": "string",
          "minLength": 1
        },
        "decision_revision": {
          "type": "integer",
          "minimum": 0
        },
        "expected_state_version": {
          "type": "integer",
          "minimum": 0
        },
        "submitted_by": {
          "enum": [
            "US",
            "USSR"
          ]
        },
        "choice": {
          "enum": [
            "Pass",
            "ImproveOne",
            "DegradeOne"
          ]
        }
      }
    },
    "arms_race": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "card_id",
        "effect_id",
        "description",
        "template",
        "beneficiary",
        "metric",
        "comparison",
        "verified_earned_upper_boundary",
