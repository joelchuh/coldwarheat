    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fidel": {
          "$ref": "#/$defs/ClearOpponentThenEnsureControl"
        },
        "romanian_abdication": {
          "$ref": "#/$defs/ClearOpponentThenEnsureControl"
        },
        "nasser": {
          "$ref": "#/$defs/AddThenRemoveFraction"
        },
        "truman_doctrine": {
          "$ref": "#/$defs/RemoveOpponentFromUncontrolledCountry"
        },
        "decolonization": {
          "$ref": "#/$defs/AddToDistinctCountries"
        }
      },
      "required": [
        "fidel",
        "romanian_abdication",
        "nasser",
        "truman_doctrine",
        "decolonization"
      ]
    }
  },
  "required": [
    "schema_version",
    "dataset_id",
    "content_version",
    "ruleset_id",
    "scope",
    "description",
    "source_catalog",
    "parameters"
  ]
