{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:coldwarheat:contract:early-influence-parameters:1",
  "title": "early-influence-parameters",
  "description": "早期影响力第一批参数v1：四种封闭的参数形状；未知字段/操作拒绝，JSON不保存可执行步骤。",
  "$defs": {
    "ClearOpponentThenEnsureControl": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "card_id": {
          "type": "string",
          "pattern": "^card\\.[a-z][a-z0-9_]*(\\.[a-z0-9_]+)*$"
        },
        "effect_id": {
          "type": "string",
          "pattern": "^effect\\.[a-z][a-z0-9_]*(\\.[a-z0-9_]+)*$"
        },
        "template": {
          "const": "ClearOpponentThenEnsureControl"
        },
        "beneficiary": {
          "enum": [
            "US",
            "USSR"
          ]
        },
        "target_country_id": {
          "type": "string",
          "pattern": "^country\\.[a-z][a-z0-9_]*(\\.[a-z0-9_]+)*$"
        },
        "source_refs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "source_id": {
                "type": "string",
                "minLength": 1
              },
              "locator": {
                "type": "string",
                "minLength": 1
              },
              "verification": {
                "enum": [
                  "Verified",
                  "Pending",
                  "Fixture"
                ]
              }
            },
            "required": [
              "source_id",
              "locator",
              "verification"
            ]
          },
          "minItems": 1,
          "description": "逐项资料定位；Fixture不可作为正式规则证据。"
        }
      },
      "required": [
        "card_id",
        "effect_id",
        "template",
        "beneficiary",
        "target_country_id",
        "source_refs"
      ]
    },
    "AddThenRemoveFraction": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "card_id": {
          "type": "string",
          "pattern": "^card\\.[a-z][a-z0-9_]*(\\.[a-z0-9_]+)*$"
        },
        "effect_id": {
          "type": "string",
          "pattern": "^effect\\.[a-z][a-z0-9_]*(\\.[a-z0-9_]+)*$"
        },
        "template": {
          "const": "AddThenRemoveFraction"
        },
        "beneficiary": {
          "enum": [
            "US",
            "USSR"
          ]
        },
        "target_country_id": {
          "type": "string",
          "pattern": "^country\\.[a-z][a-z0-9_]*(\\.[a-z0-9_]+)*$"
        },
        "add_amount": {
          "type": "integer",
          "minimum": 1
        },
        "removal_divisor": {
          "type": "integer",
          "minimum": 2
        },
        "removal_rounding": {
          "const": "Ceiling"
        },
        "source_refs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "source_id": {
                "type": "string",
                "minLength": 1
              },
              "locator": {
                "type": "string",
                "minLength": 1
              },
              "verification": {
                "enum": [
                  "Verified",
                  "Pending",
                  "Fixture"
                ]
              }
            },
            "required": [
              "source_id",
              "locator",
              "verification"
            ]
          },
          "minItems": 1,
          "description": "逐项资料定位；Fixture不可作为正式规则证据。"
        }
      },
      "required": [
        "card_id",
        "effect_id",
        "template",
        "beneficiary",
        "target_country_id",
        "add_amount",
        "removal_divisor",
        "removal_rounding",
        "source_refs"
      ]
    },
    "RemoveOpponentFromUncontrolledCountry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "card_id": {
          "type": "string",
          "pattern": "^card\\.[a-z][a-z0-9_]*(\\.[a-z0-9_]+)*$"
        },
        "effect_id": {
          "type": "string",
          "pattern": "^effect\\.[a-z][a-z0-9_]*(\\.[a-z0-9_]+)*$"
        },
        "template": {
          "const": "RemoveOpponentFromUncontrolledCountry"
        },
        "beneficiary": {
          "enum": [
            "US",
            "USSR"
          ]
        },
        "target_region_id": {
          "type": "string",
          "pattern": "^region\\.[a-z][a-z0-9_]*(\\.[a-z0-9_]+)*$"
        },
        "target_control": {
          "const": "NeitherSide"
        },
        "target_count": {
          "const": 1
        },
        "source_refs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "source_id": {
                "type": "string",
                "minLength": 1
              },
              "locator": {
                "type": "string",
                "minLength": 1
              },
              "verification": {
                "enum": [
                  "Verified",
                  "Pending",
                  "Fixture"
                ]
              }
            },
            "required": [
              "source_id",
              "locator",
              "verification"
            ]
          },
          "minItems": 1,
          "description": "逐项资料定位；Fixture不可作为正式规则证据。"
        }
      },
      "required": [
        "card_id",
        "effect_id",
        "template",
        "beneficiary",
        "target_region_id",
        "target_control",
        "target_count",
        "source_refs"
      ]
    },
    "AddToDistinctCountries": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "card_id": {
          "type": "string",
          "pattern": "^card\\.[a-z][a-z0-9_]*(\\.[a-z0-9_]+)*$"
        },
        "effect_id": {
          "type": "string",
          "pattern": "^effect\\.[a-z][a-z0-9_]*(\\.[a-z0-9_]+)*$"
        },
        "template": {
          "const": "AddToDistinctCountries"
