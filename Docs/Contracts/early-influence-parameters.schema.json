          "enum": [
            "US",
            "USSR"
          ]
        },
        "target_region_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^region\\.[a-z][a-z0-9_]*(\\.[a-z0-9_]+)*$"
          }
        },
        "target_count": {
          "type": "integer",
          "minimum": 1
        },
        "amount_per_country": {
          "type": "integer",
          "minimum": 1
        },
        "source_refs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "source_id": {
                "type": "string",
                "minLength": 1
              },
              "locator": {
                "type": "string",
                "minLength": 1
              },
              "verification": {
                "enum": [
                  "Verified",
                  "Pending",
                  "Fixture"
                ]
              }
            },
            "required": [
              "source_id",
              "locator",
              "verification"
            ]
          },
          "minItems": 1,
          "description": "逐项资料定位；Fixture不可作为正式规则证据。"
        }
      },
      "required": [
        "card_id",
        "effect_id",
        "template",
        "beneficiary",
        "target_region_ids",
        "target_count",
        "amount_per_country",
        "source_refs"
      ]
    }
  },
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "dataset_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)*$"
    },
    "content_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "ruleset_id": {
      "type": "string",
      "pattern": "^ruleset\\.[a-z][a-z0-9_]*(\\.[a-z0-9_]+)*$"
    },
    "scope": {
      "enum": [
        "fixture",
        "release-candidate"
      ]
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "source_catalog": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": [
              "string",
              "null"
            ]
          },
          "edition": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "url",
          "edition",
          "description"
        ]
      },
      "minItems": 1
