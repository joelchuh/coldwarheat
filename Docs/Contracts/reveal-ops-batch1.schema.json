        "source_card_id": {
          "enum": [
            "card.cia_created",
            "card.lone_gunman"
          ]
        },
        "source_effect_id": {
          "enum": [
            "effect.cia_created",
            "effect.lone_gunman"
          ]
        },
        "resolution_id": {
          "type": "string",
          "minLength": 1
        },
        "frame_id": {
          "type": "string",
          "minLength": 1
        },
        "step_id": {
          "const": "RevealCurrentOpponentHand"
        },
        "root_action_id": {
          "type": "string",
          "minLength": 1
        },
        "parent_frame_id": {
          "type": "string",
          "minLength": 1
        },
        "root_phasing_player": {
          "enum": [
            "US",
            "USSR"
          ]
        },
        "source_kind": {
          "enum": [
            "RootEvent",
            "OpponentCardEvent",
            "HeadlineEvent",
            "VerifiedHandEventChild"
          ]
        },
        "provider_contract_id": {
          "type": "string",
          "minLength": 1
        },
        "source_proof_id": {
          "type": "string",
          "minLength": 1
        },
        "actor": {
          "enum": [
            "US",
            "USSR"
          ]
        },
        "decision_owner": {
          "enum": [
            "US",
            "USSR"
          ]
        },
        "recipient": {
          "enum": [
            "US",
            "USSR"
          ]
        },
        "hand_owner": {
          "enum": [
            "US",
            "USSR"
          ]
        },
        "ruleset_id": {
          "const": "ruleset.deluxe2015"
        },
        "data_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "source_instance_id": {
          "type": "string",
          "minLength": 1
        },
        "root_phase": {
          "enum": [
            "ActionRound",
            "Headline"
          ]
        },
        "source_location": {
          "$ref": "#/$defs/source_location"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "source_card_id": {
                "const": "card.cia_created"
              }
            }
          },
          "then": {
            "properties": {
              "source_effect_id": {
                "const": "effect.cia_created"
              },
              "actor": {
                "const": "US"
              },
              "decision_owner": {
                "const": "US"
              },
              "recipient": {
                "const": "US"
              },
              "hand_owner": {
                "const": "USSR"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "source_card_id": {
                "const": "card.lone_gunman"
              }
            }
          },
          "then": {
            "properties": {
              "source_effect_id": {
                "const": "effect.lone_gunman"
              },
              "actor": {
                "const": "USSR"
              },
              "decision_owner": {
                "const": "USSR"
              },
              "recipient": {
                "const": "USSR"
              },
              "hand_owner": {
                "const": "US"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "source_kind": {
                "const": "VerifiedHandEventChild"
              }
            }
          },
          "then": {
            "properties": {
              "provider_contract_id": {
                "const": "urn:coldwarheat:contract:hand-events-batch1:1"
              },
              "source_card_id": {
                "const": "card.cia_created"
              }
            }
          },
          "else": {
            "properties": {
              "provider_contract_id": {
                "const": "module.turn-flow"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "source_kind": {
                "const": "HeadlineEvent"
              }
            }
          },
          "then": {
            "properties": {
              "root_phase": {
                "const": "Headline"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "source_kind": {
                "enum": [
                  "RootEvent",
                  "OpponentCardEvent"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "root_phase": {
                "const": "ActionRound"
              }
            }
          }
        }
      ]
    },
