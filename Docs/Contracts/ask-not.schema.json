    },
    "source_catalog": {
      "const": [
        {
          "id": "C-DELUXE-EN",
          "url": "https://www.gmtgames.com/nnts/TS_Cards_Deluxe.pdf",
          "edition": "English Deluxe images, checked 2026-10-13",
          "description": "Personally viewed PDF p12 #77, US3 Mid starred: US may discard up to entire hand including scoring; replacement count decided before any draw."
        },
        {
          "id": "R2015",
          "url": "https://www.gmtgames.com/nnts/TS_Rules-2015.pdf",
          "edition": "Deluxe 2015",
          "description": "PDFp4 sections4.3/4.3.1/4.4: consume old deck, empty deck reshuffles all discards, era insertion at era transition only; p5 5.2/5.4 discard without event; section9 China separate."
        },
        {
          "id": "F2010",
          "url": "https://www.gmtgames.com/nnts/FAQv5.pdf",
          "edition": "Compatible FAQv5",
          "description": "PDFp15 #77: choosing replacements creates no held-scoring exemption. p16 #98 intro excludes pre-Remix sequencing questions; old Ames order is not adopted."
        },
        {
          "id": "PROJECT-AN1",
          "url": null,
          "edition": "Explicit derivation and finite-provider design, 2026-10-13",
          "description": "Zero selection is successful no-change event. Freshly discarded selected cards join all discards and may be redrawn. Positive draw exactly exhausting old deck reshuffles eligible current discards before source/parent cleanup, without extra draw, from R2015 4.3/4.3.1; not specialist FAQ. Locked selection and bound permutation receipts are engineering; real shuffle/RNG, authentication and durable storage remain planned."
        }
      ]
