{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:coldwarheat:contract:scoring-card-parameters:2",
  "title": "中国牌最终计分奖励参数",
  "description": "仅定义最终持有奖励与适用时机；地区分值和卡牌印刷定义从其他共享数据引用。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "status",
    "description",
    "sources",
    "cards",
    "content_version"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "id": {
      "const": "cards.deluxe2015.scoring-parameters"
    },
    "status": {
      "const": "verified-subset"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "sources": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "required": [
          "id",
          "url"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": true
      }
    },
    "cards": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "parameters",
          "applies_at",
          "basis"
        ],
        "properties": {
          "id": {
            "const": "card.china"
          },
          "parameters": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "final_holder_vp"
            ],
            "properties": {
              "final_holder_vp": {
                "type": "integer",
                "minimum": 0,
                "maximum": 2147483647
              }
            }
          },
          "applies_at": {
            "const": "Turn10FinalScoring"
          },
          "basis": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "content_version": {
      "const": "0.2.0"
    }
  }
}
