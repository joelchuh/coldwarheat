          "enum": [
            "module.turn-flow",
            "Unknown"
          ]
        },
        "boundary_id": {
          "type": "string",
          "minLength": 1
        },
        "turn": {
          "type": "integer",
          "minimum": 1
        },
        "phase": {
          "enum": [
            "ExpireAndReset",
            "Unknown"
          ]
        },
        "revision": {
          "type": "integer",
          "minimum": 0
        },
        "state_digest": {
          "type": "string",
