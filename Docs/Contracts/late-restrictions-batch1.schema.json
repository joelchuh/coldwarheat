{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:coldwarheat:contract:late-restrictions-batch1:1",
  "title": "LR1 turn restrictions and provider contracts",
  "description": "Closed JSON shape plus mandatory source/lifetime/receipt semantic checks; not a runtime service.",
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "card_id",
        "effect_id",
        "instance_id",
        "frame_id",
        "resolution_id",
        "root_frame_id",
        "root_action_id",
        "root_phasing_player",
        "controller",
        "kind",
        "phase",
        "ruleset_id",
        "data_digest"
      ],
      "properties": {
        "card_id": {
          "enum": [
            "card.iran_contra_scandal",
            "card.chernobyl"
          ]
        },
        "effect_id": {
          "enum": [
            "effect.iran_contra_scandal",
            "effect.chernobyl"
          ]
        },
        "instance_id": {
          "type": "string",
          "minLength": 1
        },
        "frame_id": {
          "type": "string",
          "minLength": 1
        },
        "resolution_id": {
          "type": "string",
          "minLength": 1
        },
        "root_frame_id": {
          "type": "string",
          "minLength": 1
        },
        "root_action_id": {
          "type": "string",
          "minLength": 1
        },
        "root_phasing_player": {
          "enum": [
            "US",
            "USSR"
          ]
        },
        "controller": {
          "enum": [
            "US",
            "USSR"
          ]
        },
        "kind": {
          "enum": [
            "RootEvent",
            "OpponentCardEvent",
            "HeadlineEvent",
            "VerifiedFypUsChild",
            "Unknown"
          ]
        },
        "phase": {
          "enum": [
            "ActionRound",
            "Headline"
          ]
        },
        "ruleset_id": {
          "const": "ruleset.deluxe2015"
        },
        "data_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "card_entity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "instance_id",
        "card_id",
        "owner",
        "zone",
        "frame_id"
      ],
      "properties": {
        "instance_id": {
          "type": "string",
          "minLength": 1
        },
        "card_id": {
          "type": "string",
          "minLength": 1
        },
        "owner": {
          "enum": [
            "US",
            "USSR"
          ]
        },
        "zone": {
          "enum": [
            "Hand",
            "InResolution",
            "RemovedFromGame",
            "DiscardPile"
          ]
        },
        "frame_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "frame": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "frame_id",
        "resolution_id",
        "parent_frame_id",
        "kind",
        "root_action_id",
        "controller",
        "source_instance_id",
        "card_id",
        "status",
        "remaining_work"
      ],
      "properties": {
        "frame_id": {
          "type": "string",
          "minLength": 1
        },
        "resolution_id": {
          "type": "string",
          "minLength": 1
        },
        "parent_frame_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "kind": {
          "enum": [
            "RootCard",
            "CardEvent",
            "FiveYearPlanEvent"
          ]
        },
        "root_action_id": {
          "type": "string",
          "minLength": 1
        },
        "controller": {
          "enum": [
            "US",
            "USSR"
          ]
        },
        "source_instance_id": {
          "type": "string",
          "minLength": 1
        },
        "card_id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "Active",
            "WaitingChild",
            "WaitingRegion",
            "Completed"
          ]
        },
        "remaining_work": {
          "enum": [
            "FinalizeAfterEvent",
            "OperationsAfterEvent",
            "Unknown"
          ]
        }
      }
    },
    "success_fact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resolution_id",
        "frame_id",
        "source_instance_id",
        "card_id",
        "effect_id",
        "controller",
        "turn",
        "outcome",
        "proof_id"
      ],
      "properties": {
        "resolution_id": {
          "type": "string",
          "minLength": 1
        },
        "frame_id": {
          "type": "string",
          "minLength": 1
        },
        "source_instance_id": {
          "type": "string",
          "minLength": 1
        },
        "card_id": {
          "type": "string",
          "minLength": 1
        },
        "effect_id": {
          "type": "string",
          "minLength": 1
        },
        "controller": {
          "enum": [
            "US",
            "USSR"
          ]
        },
        "turn": {
          "type": "integer",
          "minimum": 1
        },
        "outcome": {
          "const": "EventSucceeded"
        },
        "proof_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "root_slot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root_action_id",
        "turn",
        "actor"
      ],
      "properties": {
        "root_action_id": {
          "type": "string",
          "minLength": 1
        },
        "turn": {
          "type": "integer",
          "minimum": 1
        },
        "actor": {
          "enum": [
            "US",
            "USSR"
          ]
        }
      }
    },
    "influence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "country_id",
        "US",
        "USSR"
      ],
      "properties": {
        "country_id": {
          "type": "string",
          "minLength": 1
        },
        "US": {
          "type": "integer",
          "minimum": 0
        },
        "USSR": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "dispatch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider_id",
        "accepted_source",
        "root_remaining_work",
        "parent_frame_id",
        "parent_resolution_id",
        "parent_source_instance_id",
        "parent_card_id",
        "parent_controller",
        "fyp_selection_receipt_id",
        "selected_instance_id",
        "selected_card_id",
        "selected_from_owner",
        "accepted_revision",
        "proof_id"
      ],
      "properties": {
        "provider_id": {
          "enum": [
            "module.turn-flow",
            "module.hand-events-batch1",
            "Unknown"
          ]
        },
        "accepted_source": {
          "$ref": "#/$defs/source"
        },
        "root_remaining_work": {
          "enum": [
            "FinalizeAfterEvent",
            "OperationsAfterEvent",
            "Unknown"
          ]
        },
        "parent_frame_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "parent_resolution_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "parent_source_instance_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "parent_card_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "parent_controller": {
          "anyOf": [
            {
              "enum": [
                "US",
                "USSR"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "fyp_selection_receipt_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "selected_instance_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "selected_card_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "selected_from_owner": {
          "anyOf": [
            {
              "enum": [
                "US",
                "USSR"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "accepted_revision": {
          "type": "integer",
          "minimum": 0
        },
        "proof_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command_id",
        "expected_revision",
        "source_digest"
      ],
      "properties": {
        "command_id": {
          "type": "string",
          "minLength": 1
        },
        "expected_revision": {
          "type": "integer",
          "minimum": 0
        },
        "source_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "active_restriction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "instance_id",
        "card_id",
        "effect_id",
        "source_instance_id",
        "source_frame_id",
        "source_resolution_id",
        "root_frame_id",
        "controller",
        "activated_turn",
        "selected_region",
        "status",
        "expiry_boundary_id",
        "source_kind",
        "source_phase"
      ],
      "properties": {
        "instance_id": {
          "type": "string",
          "minLength": 1
        },
        "card_id": {
          "type": "string",
          "minLength": 1
        },
        "effect_id": {
          "type": "string",
          "minLength": 1
        },
        "source_instance_id": {
          "type": "string",
          "minLength": 1
        },
        "source_frame_id": {
          "type": "string",
          "minLength": 1
        },
        "source_resolution_id": {
          "type": "string",
          "minLength": 1
        },
        "root_frame_id": {
          "type": "string",
          "minLength": 1
        },
        "controller": {
          "enum": [
            "US",
            "USSR"
          ]
        },
        "activated_turn": {
          "type": "integer",
          "minimum": 1
        },
        "selected_region": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "enum": [
            "Active",
            "Expired"
          ]
        },
        "expiry_boundary_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "source_kind": {
          "enum": [
            "RootEvent",
            "OpponentCardEvent",
            "HeadlineEvent",
            "VerifiedFypUsChild"
          ]
        },
        "source_phase": {
          "enum": [
            "ActionRound",
            "Headline"
          ]
        }
      }
    },
    "expiry_fact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "boundary_id",
        "turn",
        "phase",
        "revision_before",
        "provider_id",
        "proof_id"
      ],
      "properties": {
        "boundary_id": {
          "type": "string",
          "minLength": 1
        },
        "turn": {
          "type": "integer",
          "minimum": 1
        },
        "phase": {
          "const": "ExpireAndReset"
        },
        "revision_before": {
          "type": "integer",
          "minimum": 0
        },
        "provider_id": {
          "const": "module.turn-flow"
        },
        "proof_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "pending_region": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selection_id",
        "source_digest",
        "choosing_side",
        "region_ids",
        "phase"
      ],
      "properties": {
        "selection_id": {
          "type": "string",
          "minLength": 1
        },
        "source_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "choosing_side": {
          "const": "US"
        },
        "region_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "phase": {
          "const": "AwaitingRegion"
        }
      }
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revision",
        "turn",
        "phase",
        "status",
        "vp",
        "defcon",
        "winner",
        "rng_cursor",
        "military",
        "influence",
        "cards",
        "frames",
        "success_facts",
        "completed_slots",
        "active_restrictions",
        "expiry_facts",
        "coverage",
        "pending"
      ],
      "properties": {
        "revision": {
          "type": "integer",
          "minimum": 0
        },
        "turn": {
          "type": "integer",
          "minimum": 1
        },
        "phase": {
          "enum": [
            "ActionRound",
            "Headline",
            "ExpireAndReset"
          ]
        },
        "status": {
          "enum": [
            "Running",
            "Finished"
          ]
        },
        "vp": {
          "type": "integer"
        },
        "defcon": {
          "type": "integer"
        },
        "winner": {
          "anyOf": [
            {
              "enum": [
                "US",
                "USSR",
                "Draw"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "rng_cursor": {
          "type": "integer",
          "minimum": 0
        },
        "military": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "US",
            "USSR"
          ],
          "properties": {
            "US": {
              "type": "integer",
              "minimum": 0
            },
            "USSR": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "influence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/influence"
          }
        },
        "cards": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/card_entity"
          }
        },
        "frames": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/frame"
          }
        },
        "success_facts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/success_fact"
          }
        },
        "completed_slots": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/root_slot"
          }
        },
        "active_restrictions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/active_restriction"
          }
        },
        "expiry_facts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/expiry_fact"
          }
        },
        "coverage": {
          "enum": [
            "CompleteForLR1",
            "Unknown"
          ]
        },
        "pending": {
          "anyOf": [
            {
              "$ref": "#/$defs/pending_region"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "start_input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "state",
        "dispatch",
        "request",
        "authenticated_actor"
      ],
      "properties": {
        "source": {
          "$ref": "#/$defs/source"
        },
        "state": {
          "$ref": "#/$defs/snapshot"
        },
        "dispatch": {
          "$ref": "#/$defs/dispatch"
        },
        "request": {
          "$ref": "#/$defs/request"
        },
        "authenticated_actor": {
          "enum": [
            "US",
            "USSR"
          ]
        }
      }
    },
    "choice_request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command_id",
        "expected_revision",
        "selection_id",
        "choice",
        "region_id"
      ],
      "properties": {
        "command_id": {
          "type": "string",
          "minLength": 1
        },
        "expected_revision": {
          "type": "integer",
          "minimum": 0
        },
        "selection_id": {
          "type": "string",
          "minLength": 1
        },
        "choice": {
          "enum": [
            "SelectRegion",
            "Decline"
          ]
        },
        "region_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "choice_input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "prefix_receipt",
        "prefix_anchor",
        "request",
        "authenticated_actor"
      ],
      "properties": {
        "state": {
          "$ref": "#/$defs/snapshot"
        },
        "prefix_receipt": {
          "$ref": "#/$defs/receipt"
        },
        "prefix_anchor": {
          "$ref": "#/$defs/anchor"
        },
        "request": {
          "$ref": "#/$defs/choice_request"
        },
        "authenticated_actor": {
          "enum": [
            "US",
            "USSR"
          ]
        }
      }
    },
    "boundary_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider_id",
        "boundary_id",
        "turn",
        "phase",
        "revision",
        "state_digest",
