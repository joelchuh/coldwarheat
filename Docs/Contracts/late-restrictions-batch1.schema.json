            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "die_side": {
          "anyOf": [
            {
              "enum": [
                "US",
                "USSR"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
