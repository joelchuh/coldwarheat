  "$defs": {
    "olympic_games": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "card_id",
        "effect_id",
        "description",
        "template",
        "sponsor",
        "opponent",
        "branch_decision_owner",
        "branches",
        "participate",
        "boycott",
        "source_refs"
      ],
      "properties": {
        "card_id": {
          "const": "card.olympic_games"
        },
        "effect_id": {
          "const": "effect.olympic_games"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "template": {
          "const": "OpponentChoiceOlympicContestOrBoycottOps"
        },
        "sponsor": {
          "const": "EffectController"
        },
        "opponent": {
          "const": "OpponentOfSponsor"
        },
        "branch_decision_owner": {
          "const": "OpponentOfSponsor"
        },
        "branches": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "prefixItems": [
            {
              "const": "Participate"
            },
            {
              "const": "Boycott"
            }
          ],
          "items": false
        },
        "participate": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "die_ref",
            "draw_order",
            "sponsor_die_modifier",
            "comparison",
            "winner_vp",
            "tie_policy",
            "tie_vp",
            "vp_checkpoint",
            "military_credit",
            "branch_change_after_accepted_pair",
            "resume_state_policy"
          ],
          "properties": {
            "die_ref": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "dataset_id",
                "json_pointer"
              ],
              "properties": {
                "dataset_id": {
                  "const": "rules.deluxe2015.standard-dice"
                },
                "json_pointer": {
                  "const": "/definitions/standard_d6"
                }
              }
            },
            "draw_order": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "prefixItems": [
                {
                  "const": "US"
                },
                {
                  "const": "USSR"
                }
              ],
              "items": false
            },
            "sponsor_die_modifier": {
              "const": 2
            },
            "comparison": {
              "const": "StrictlyHigherModifiedTotal"
            },
            "winner_vp": {
              "const": 2
            },
            "tie_policy": {
              "const": "MandatoryNewPairedRoll"
            },
            "tie_vp": {
              "const": 0
            },
            "vp_checkpoint": {
              "const": "VpBatchClosed"
            },
            "military_credit": {
              "const": "None"
            },
            "branch_change_after_accepted_pair": {
              "const": false
            },
            "resume_state_policy": {
              "const": "ValidateInitialRunningState_UnchangedDefcon_PhaseSpecificTerminalBeforeEveryPair"
            }
          }
        },
        "boycott": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "defcon_delta",
            "ordered_steps",
            "defcon_ref",
            "nuclear_loser",
            "terminal_grant",
            "operations"
          ],
          "properties": {
            "defcon_delta": {
              "const": -1
            },
            "ordered_steps": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "prefixItems": [
                {
                  "const": "DegradeDefcon"
                },
                {
                  "const": "NuclearWarReachedCheckpoint"
                },
                {
                  "const": "IfContinueOfferOptionalAsIfCardOperations"
                }
              ],
              "items": false
            },
            "defcon_ref": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "dataset_id",
                "json_pointer"
              ],
              "properties": {
                "dataset_id": {
                  "const": "rules.deluxe2015.defcon"
                },
                "json_pointer": {
                  "const": ""
                }
              }
            },
            "nuclear_loser": {
              "const": "InheritedRootPhasingPlayer"
            },
            "terminal_grant": {
              "const": "None"
            },
            "operations": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "actor",
                "base_ops",
                "budget_source",
                "ops_policy_ref",
                "allowed_modes",
                "may_decline",
                "mode_lock",
                "finish_policy",
                "coup_credit_kind",
                "military_policy_ref",
                "intervention_ref",
                "geographic_exemption",
                "treaty_exemption",
                "space_allowed",
                "extra_card",
                "extra_root_action",
                "modifier_policy",
                "influence_baseline",
                "missing_influence_baseline",
                "ordinary_nuclear_loser",
                "fatal_crisis_loser"
              ],
              "properties": {
                "actor": {
                  "const": "Sponsor"
                },
                "base_ops": {
                  "const": 4
                },
                "budget_source": {
                  "const": "VerifiedEventLiteral"
                },
                "ops_policy_ref": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "dataset_id",
                    "json_pointer"
                  ],
                  "properties": {
                    "dataset_id": {
                      "const": "effects.deluxe2015.persistent_batch1"
                    },
                    "json_pointer": {
                      "const": "/ops_policy"
                    }
                  }
                },
                "allowed_modes": {
                  "type": "array",
                  "minItems": 3,
                  "maxItems": 3,
                  "prefixItems": [
                    {
                      "const": "Influence"
                    },
                    {
                      "const": "Coup"
                    },
                    {
                      "const": "Realignment"
                    }
                  ],
                  "items": false
                },
                "may_decline": {
                  "const": true
                },
                "mode_lock": {
                  "const": "FirstAcceptedOperation"
                },
                "finish_policy": {
                  "const": "BetweenAcceptedOperationsMayForfeitRemainder"
                },
                "coup_credit_kind": {
                  "const": "OperationsCoup"
                },
                "military_policy_ref": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "dataset_id",
                    "json_pointer"
                  ],
                  "properties": {
                    "dataset_id": {
                      "const": "rules.deluxe2015.military-operations"
                    },
                    "json_pointer": {
                      "const": "/credit_sources/OperationsCoup"
                    }
                  }
                },
                "intervention_ref": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "dataset_id",
                    "json_pointer"
                  ],
                  "properties": {
                    "dataset_id": {
                      "const": "effects.deluxe2015.defcon_events_batch1"
                    },
                    "json_pointer": {
                      "const": "/intervention_policy"
                    }
                  }
                },
                "geographic_exemption": {
                  "const": false
                },
                "treaty_exemption": {
                  "const": false
                },
                "space_allowed": {
                  "const": false
                },
                "extra_card": {
                  "const": false
                },
                "extra_root_action": {
                  "const": false
                },
                "modifier_policy": {
                  "const": "ActorEffectsAndVerifiedRegionalHistory"
                },
                "influence_baseline": {
                  "const": "RootActionRoundStartActorOrSeparatelyVerifiedNamedPolicy"
                },
                "missing_influence_baseline": {
                  "const": "RequiresRulingOnlyInfluenceQueryOrChoice"
                },
                "ordinary_nuclear_loser": {
                  "const": "InheritedRootPhasingPlayer"
                },
                "fatal_crisis_loser": {
                  "const": "ActualCoupActor"
                }
              }
            }
          }
        },
        "source_refs": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "prefixItems": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "source_id",
                "locator",
                "verification"
              ],
              "properties": {
                "source_id": {
                  "const": "C-DELUXE-EN"
                },
                "locator": {
                  "const": "亲看PDF p4英文#20：控制者主办、对手参赛/抵制；参赛双方骰主办+2高者2VP平手重掷；抵制DEFCON降1再可选视同4OPS；Neutral2Early非星号。"
                },
                "verification": {
                  "const": "Verified"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "source_id",
                "locator",
                "verification"
              ],
              "properties": {
                "source_id": {
                  "const": "R2015"
                },
                "locator": {
                  "const": "§2.0标准D6；§4.2/4.5C根身份；§6.0/6.1.1普通OPS与行动轮开始；§7.4.1–3修正；§8.1.3含Olympic抵制核战例；§10.3.1完整VP批次终局。"
                },
                "verification": {
                  "const": "Verified"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "source_id",
                "locator",
                "verification"
              ],
              "properties": {
                "source_id": {
                  "const": "F2010"
                },
                "locator": {
                  "const": "PDF p13 #62再次引用Olympic抵制的Phasing责任并区分CMC实际Actor；p14 #67事件OPS没有可弃实体不能太空的说明。"
                },
                "verification": {
                  "const": "Verified"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "source_id",
                "locator",
                "verification"
              ],
              "properties": {
                "source_id": {
                  "const": "PROJECT-OG1"
                },
                "locator": {
                  "const": "US后USSR取样、每对骰原子收据、平手内部继续链/有限执行片段、不设游戏重掷上限、拒绝保留既有收据；来源与真实持久化仍planned。"
                },
                "verification": {
                  "const": "Verified"
                }
              }
            }
          ],
          "items": false
        }
      }
    },
    "source_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "card_id",
        "source_instance_id",
        "effect_id",
        "resolution_id",
        "frame_id",
        "parent_frame_id",
        "root_action_id",
        "root_phasing_player",
        "sponsor",
        "opponent",
        "branch_owner",
        "source_kind",
        "phase",
        "provider_contract_id",
        "provider_proof_id",
        "source_zone",
        "ruleset_id",
        "ruleset_version",
        "data_digest"
      ],
      "properties": {
        "card_id": {
          "const": "card.olympic_games"
        },
        "source_instance_id": {
          "type": "string",
          "minLength": 1
        },
        "effect_id": {
          "const": "effect.olympic_games"
        },
        "resolution_id": {
          "type": "string",
          "minLength": 1
        },
        "frame_id": {
          "type": "string",
          "minLength": 1
        },
        "parent_frame_id": {
          "type": "string",
          "minLength": 1
        },
        "root_action_id": {
          "type": "string",
          "minLength": 1
        },
        "root_phasing_player": {
          "enum": [
            "US",
            "USSR"
          ]
        },
        "sponsor": {
          "enum": [
            "US",
            "USSR"
          ]
        },
        "opponent": {
          "enum": [
            "US",
            "USSR"
          ]
        },
        "branch_owner": {
          "enum": [
            "US",
            "USSR"
          ]
        },
        "source_kind": {
          "enum": [
            "RootEvent",
            "HeadlineEvent",
            "VerifiedNestedEvent"
          ]
        },
        "phase": {
          "enum": [
            "ActionRound",
            "Headline"
          ]
        },
        "provider_contract_id": {
          "type": "string",
          "minLength": 1
        },
        "provider_proof_id": {
          "type": "string",
          "minLength": 1
        },
        "source_zone": {
          "const": "InResolution"
        },
        "ruleset_id": {
          "const": "ruleset.deluxe2015"
        },
        "ruleset_version": {
          "type": "string",
          "minLength": 1
        },
        "data_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "sponsor": {
