        },
        "source_card_disposition": {
          "const": "SharedPrintedRemovalPolicy"
        },
        "root_slot": {
          "const": "NoAdditionalRootAction"
        },
        "finished": {
          "const": "AbsorbingExceptAuthorizedOriginalReceiptReplay"
        }
      }
