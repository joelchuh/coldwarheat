          "items": false
        },
        "nested_sources": {
          "const": "RequiresSeparatelyBoundProviderAndVerifiedRootInheritance"
        },
        "unknown_provider": {
          "const": "RequiresRulingBeforeChoiceOrRandomOrMutation"
        },
        "unknown_relevant_effect": {
          "const": "RequiresRulingBeforeAffectedStep"
