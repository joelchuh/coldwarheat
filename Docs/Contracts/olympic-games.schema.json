          "const": "InResolution"
        },
        "source_validation": {
          "const": "ExactCardEffectPhaseFrameRevisionRulesAndDataBinding"
        },
        "running_state": {
          "const": "RejectNuclearDefconOrAlreadyWinningVpOrCorruptState"
        }
      }
    },
    "receipt_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "initial_participation",
        "pair_atomicity",
        "pair_identity",
        "pair_digest",
        "canonical_format",
        "request_digest",
        "next_binding",
        "retry",
        "conflicting_retry",
        "failed_initial_pair",
        "failed_later_pair",
        "boycott_atomicity",
        "later_ops_failure"
      ],
      "properties": {
        "initial_participation": {
          "const": "BranchLockAndFirstCompletePairAtomic"
        },
        "pair_atomicity": {
          "const": "BothRawDiceTotalsOutcomeVpRngAndContinuationTogether"
        },
        "pair_identity": {
          "const": "ResolutionIdAndOneBasedRoundIndex"
        },
        "pair_digest": {
          "const": "CanonicalSha256OfCompleteTypedReceiptBody"
        },
        "canonical_format": {
          "const": "UTF8SortedKeysCompactJSONIntegersOnlyNoNaN"
        },
        "request_digest": {
          "const": "CanonicalOriginalBranchRequestAndSourceFrameDigest"
        },
        "next_binding": {
          "const": "NextRoundIndexPreviousReceiptDigestAndRngCursor"
        },
        "retry": {
          "const": "AuthorizedOriginalReceiptReplayNoNewSampling"
        },
        "conflicting_retry": {
          "const": "RejectDifferentSemanticRequestForAcceptedCommandOrResolution"
        },
        "failed_initial_pair": {
          "const": "NoBranchLockNoRngCommitNoPartialReceipt"
        },
        "failed_later_pair": {
          "const": "PreservePriorCommittedPairsAndRng"
        },
        "boycott_atomicity": {
          "const": "BranchChoiceDefconTerminalOrOpsGrantTogether"
        },
        "later_ops_failure": {
          "const": "PreserveCommittedBoycottDefcon"
        }
      }
    },
    "scheduler_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ties",
        "execution_slice",
        "slice_exhausted",
        "game_reroll_limit",
        "forced_winner",
        "resume"
      ],
      "properties": {
        "ties": {
          "const": "InternalContinuationWithoutPlayerDecision"
        },
        "execution_slice": {
          "const": "PositiveBoundedPairWorkBudgetExternalToGameRules"
        },
        "slice_exhausted": {
          "const": "YieldInternalContinuation"
        },
        "game_reroll_limit": {
          "const": "None"
        },
        "forced_winner": {
          "const": "Forbidden"
        },
        "resume": {
          "const": "ValidateFullReceiptChainThenContinueNextUncommittedPair"
        }
      }
