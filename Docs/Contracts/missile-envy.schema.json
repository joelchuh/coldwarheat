  "$defs": {
    "missile_envy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "card_id",
        "effect_id",
        "description",
        "template",
        "selector",
        "source_transfer",
        "candidate_kind",
        "comparison",
        "received_route",
        "obligation",
        "source_refs"
      ],
      "properties": {
        "card_id": {
          "const": "card.missile_envy"
        },
        "effect_id": {
          "const": "effect.missile_envy"
        },
        "description": {
          "const": "Holder-modified highest exchange with shared ordinary floor/cap; confirmed empty fallback; typed received use and separate next-AR obligation."
        },
        "template": {
          "const": "ExchangeHighestThenNestedUseAndObligation"
        },
        "selector": {
          "const": "OpponentOrdinaryHandHolder"
        },
        "source_transfer": {
          "const": "SameEntityToOpponentHand"
        },
        "candidate_kind": {
          "const": "OrdinaryHandEventWithOperations"
        },
        "comparison": {
          "const": {
            "quote_actor": "OriginalHandHolder",
            "ops_policy_ref_key": "ops",
            "value": "CurrentOrdinaryOperationsValueAtComparison",
            "ordinary_bounds": "ReadSharedOpsPolicyMinimumAndOrdinaryMaximum",
            "regional_bonuses": "ExcludedFromOrdinaryComparison",
            "tie": "HolderChoosesExactlyOneMaximumAfterBounds",
            "empty": "SuccessfulNoChangeDiscardMissileEnvy_NoExchangeNoObligation",
            "china": "ExcludedSeparateCard",
            "scoring": "ExcludedNoOperationsValue"
          }
        },
        "received_route": {
          "const": {
            "same_association": "Event",
            "neutral": "Event_ControllerPending",
            "opponent_association": "Operations_SuppressEvent",
            "actual_user": "MissileEnvyEventActor",
            "ops_modifiers": "ActualUserAtUseTime"
          }
        },
        "obligation": {
          "const": {
            "storage": "IndependentPersistentRecord",
            "owner": "ExchangeRecipient",
            "card": "SameMissileEnvyEntity",
            "due": "NextNormalActionRoundOfOwner",
            "required_route": "Operations",
            "headline": "DoesNotConsumeObligation",
            "forced_scoring": "DeferKeepSourceThenFirstARNextTurn",
            "eligible_trap": "RequiredNextTrapDiscard",
            "purge_ineligible_trap": "KeepRecordRequiresRulingForLaterLifecycle",
            "completion": "OnlyAcceptedBoundActualUseOrTrapDiscardReceipt",
            "expiry": "NoAutomaticParentCompletionOrTurnEndExpiry"
          }
        },
        "source_refs": {
          "const": [
            {
              "source_id": "C-DELUXE-EN",
              "locator": "p8 #49",
              "verification": "Verified"
            },
            {
              "source_id": "R2015",
              "locator": "2.2.1 and 9.1/9.8 candidate exclusions",
              "verification": "TextualDerivation"
            },
            {
              "source_id": "R2015",
              "locator": "7.4.1-2 actual user use-time OPS",
              "verification": "Verified"
            },
            {
              "source_id": "F2010",
              "locator": "p6 actual forced-use modifier; p12 trap; pp19-20 scoring carry",
              "verification": "Verified"
            },
            {
              "source_id": "PROJECT-ME1",
              "locator": "Independent obligation, atomic transfer, receipt and finite support are engineering design",
              "verification": "EngineeringBoundary"
            },
            {
              "source_id": "PROJECT-ME1-USER-20261013",
              "locator": "User accepted holder ordinary modified comparison and empty/scoring-only completion policy on 2026-10-13",
              "verification": "HumanConfirmed"
            }
          ]
        }
      }
