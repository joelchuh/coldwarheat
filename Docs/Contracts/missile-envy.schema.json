    "child_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "provider",
        "source_digest",
        "parent_frame",
        "child_frame",
        "resolution",
        "entity",
        "card_id",
        "route",
        "actor",
        "before_hash",
        "after_influence",
        "final_zone",
        "terminal"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "provider": {
          "const": "ME1.Fidel.v1"
        },
        "source_digest": {
          "type": "string"
        },
        "parent_frame": {
          "type": "string"
        },
        "child_frame": {
          "type": "string"
        },
        "resolution": {
          "type": "string"
        },
        "entity": {
          "type": "string"
        },
        "card_id": {
          "const": "card.fidel"
        },
        "route": {
          "const": "Event"
        },
        "actor": {
          "const": "USSR"
        },
        "before_hash": {
          "type": "string"
        },
        "after_influence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/influence"
          }
        },
        "final_zone": {
          "const": "Removed"
        },
        "terminal": {
          "type": "null"
        }
      }
    },
    "public_event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "selected",
        "source"
      ],
      "properties": {
        "type": {
          "enum": [
            "AwaitingHolder",
            "Exchange",
            "ChildCompleted",
            "NoExchangeCompleted"
          ]
        },
        "selected": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command_id",
        "state",
        "events"
      ],
      "properties": {
        "command_id": {
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/state"
        },
        "events": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/public_event"
          }
        }
      }
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command",
        "source",
        "before",
        "evidence",
        "result",
        "digest"
      ],
      "properties": {
        "command": {
          "$ref": "#/$defs/command"
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "before": {
          "$ref": "#/$defs/state"
        },
        "evidence": {
          "anyOf": [
            {
              "$ref": "#/$defs/child_evidence"
            },
            {
              "type": "null"
            }
          ]
        },
        "result": {
          "$ref": "#/$defs/result"
        },
        "digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "missile_envy"
      ],
      "properties": {
        "missile_envy": {
          "$ref": "#/$defs/missile_envy"
        }
      }
    },
    "gate_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase",
        "owner",
        "slot_source",
        "scoring_due",
        "trap",
        "purge",
        "post_exception"
      ],
      "properties": {
        "phase": {
          "enum": [
            "Headline",
            "ActionRound"
          ]
        },
        "owner": {
          "enum": [
            "US",
            "USSR"
          ]
        },
        "slot_source": {
          "enum": [
            "Normal",
            "Extra"
          ]
        },
        "scoring_due": {
          "type": "boolean"
        },
        "trap": {
          "type": "boolean"
        },
        "purge": {
          "type": "boolean"
        },
        "post_exception": {
          "type": "boolean"
        }
      }
    },
    "obligation_origin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "owner",
        "source_entity",
        "source_resolution",
        "created_turn",
        "created_by"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "owner": {
          "enum": [
            "US",
            "USSR"
          ]
        },
        "source_entity": {
          "type": "string"
        },
        "source_resolution": {
          "type": "string"
        },
        "created_turn": {
          "type": "integer",
          "minimum": 0
        },
        "created_by": {
          "type": "string"
        }
      }
    },
    "gate_origin_anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "creation_digest",
        "completion_digest",
        "source_digest",
        "obligation_origin"
      ],
      "properties": {
        "creation_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "completion_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "source_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "obligation_origin": {
          "$ref": "#/$defs/obligation_origin"
        }
      }
    },
    "gate_schedule_anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schedule_id",
        "live_hash",
        "context",
        "creation_digest",
        "completion_digest",
        "modifier_effect_ids"
      ],
      "properties": {
        "schedule_id": {
          "type": "string",
          "minLength": 1
        },
        "live_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "context": {
          "$ref": "#/$defs/gate_context"
        },
        "creation_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "completion_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "modifier_effect_ids": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "US",
            "USSR"
          ],
          "properties": {
            "US": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            },
            "USSR": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            }
          }
        }
      }
    },
    "gate_trust": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "creation_receipt",
        "completion_receipt",
        "origin_anchor",
        "schedule_anchor"
      ],
      "properties": {
        "creation_receipt": {
          "$ref": "#/$defs/receipt"
        },
        "completion_receipt": {
          "$ref": "#/$defs/receipt"
        },
        "origin_anchor": {
          "$ref": "#/$defs/gate_origin_anchor"
        },
        "schedule_anchor": {
          "$ref": "#/$defs/gate_schedule_anchor"
        }
      }
    }
  }
}
