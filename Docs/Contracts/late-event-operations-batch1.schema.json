{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:coldwarheat:contract:late-event-operations-batch1:1",
  "title": "Late event prefixes and restricted operation handoff",
  "description": "Closed design contracts; semantic source/state/receipt checks are required in addition to JSON shape. Proof IDs are not authentication.",
  "$defs": {
    "soviets_shoot_down_kal_007": {
      "const": {
        "card_id": "card.soviets_shoot_down_kal_007",
        "effect_id": "effect.soviets_shoot_down_kal_007",
        "description": "DEFCON down before US VP, then optional restricted ordinary OPS if South Korea is US-controlled.",
        "template": "OrderedPrefixThenRestrictedOperations",
        "actor": "US",
        "ordered_prefix": [
          {
            "kind": "ChangeDefcon",
            "delta": -1,
            "checkpoint": "ImmediateNuclear"
          },
          {
            "kind": "AwardVp",
            "side": "US",
            "amount": 2,
            "checkpoint": "CompleteVpBatch"
          }
        ],
        "grant_condition": {
          "kind": "ActualControl",
          "country_id": "country.south_korea",
          "side": "US"
        },
        "grant": {
          "allowed_modes": [
            "Influence",
            "Realignment"
          ],
          "budget_source": "VerifiedEventLiteral",
          "base_ops": 4,
          "geographic_exemption": false,
          "coup_credit_kind": null
        }
      }
    },
    "glasnost": {
      "const": {
        "card_id": "card.glasnost",
        "effect_id": "effect.glasnost",
        "description": "USSR VP before DEFCON improvement, then restricted ordinary OPS only with a verified active Reformer.",
        "template": "OrderedPrefixThenRestrictedOperations",
        "actor": "USSR",
        "ordered_prefix": [
          {
            "kind": "AwardVp",
            "side": "USSR",
            "amount": 2,
            "checkpoint": "CompleteVpBatch"
          },
          {
            "kind": "ChangeDefcon",
            "delta": 1,
            "checkpoint": "ImmediateNuclear"
          }
        ],
        "grant_condition": {
          "kind": "VerifiedActiveReferencedEffect",
          "parameter_ref": {
            "dataset_id": "effects.deluxe2015.late_influence_batch1",
            "json_pointer": "/parameters/the_reformer"
          }
        },
        "grant": {
          "allowed_modes": [
            "Influence",
            "Realignment"
          ],
          "budget_source": "VerifiedEventLiteral",
          "base_ops": 4,
          "geographic_exemption": false,
          "coup_credit_kind": null
        }
      }
    },
    "ortega_elected_in_nicaragua": {
      "const": {
        "card_id": "card.ortega_elected_in_nicaragua",
        "effect_id": "effect.ortega_elected_in_nicaragua",
        "description": "Remove all US Nicaragua influence, then one optional free coup in a map-adjacent country.",
        "template": "OrderedPrefixThenRestrictedOperations",
        "actor": "USSR",
        "ordered_prefix": [
          {
            "kind": "ClearInfluence",
            "country_id": "country.nicaragua",
            "side": "US"
          }
        ],
        "grant_condition": {
          "kind": "Always"
        },
        "grant": {
          "allowed_modes": [
            "Coup"
          ],
          "budget_source": "SourceCardPrintedOps",
          "base_ops": null,
          "target_selector": {
            "kind": "AdjacentToCountry",
            "country_id": "country.nicaragua"
          },
          "geographic_exemption": true,
          "geographic_policy": "LEO1-D01_ScopedNamedTargetDerivation",
          "coup_credit_kind": "FreeCoup",
          "attempt_limit": 1
        }
      }
    },
