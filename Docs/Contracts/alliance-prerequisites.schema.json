{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:coldwarheat:contract:alliance-prerequisites:1",
  "title": "alliance-prerequisites",
  "description": "北约两前置卡的类型化影响力契约：不同国家放置、互斥分支、额度/每国上限与成功事实引用；不允许任意指令。",
  "$defs": {
    "AddToDistinctNonOpponentControlledCountries": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "card_id": {
          "type": "string",
          "pattern": "^card\\.[a-z][a-z0-9_]*$"
        },
        "effect_id": {
          "type": "string",
          "pattern": "^effect\\.[a-z][a-z0-9_]*$"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "beneficiary": {
          "enum": [
            "US",
            "USSR"
          ]
        },
        "target_region_id": {
          "type": "string",
          "pattern": "^region\\.[a-z][a-z0-9_]*$"
        },
        "source_refs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "source_id": {
                "type": "string",
                "minLength": 1
              },
              "locator": {
                "type": "string",
                "minLength": 1
              },
              "verification": {
                "enum": [
                  "Verified",
                  "Pending",
                  "Fixture"
                ]
              }
            },
            "required": [
              "source_id",
              "locator",
              "verification"
            ]
          },
          "minItems": 1,
          "description": "逐项资料定位；Fixture不可作为正式规则证据。"
        },
        "template": {
          "const": "AddToDistinctNonOpponentControlledCountries"
        },
        "target_control": {
          "const": "NotControlledByOpponent"
        },
        "target_count": {
          "type": "integer",
          "minimum": 1
        },
        "amount_per_country": {
          "type": "integer",
          "minimum": 1
        },
        "shortage_policy": {
          "const": "SelectAllAvailable"
        },
        "zero_candidates_outcome": {
          "const": "ResolvedNoChange"
        }
      },
      "required": [
        "card_id",
        "effect_id",
        "description",
        "beneficiary",
        "target_region_id",
        "source_refs",
        "template",
        "target_control",
        "target_count",
        "amount_per_country",
        "shortage_policy",
        "zero_candidates_outcome"
      ]
    },
    "ChooseOneInfluenceBranch": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "card_id": {
          "type": "string",
          "pattern": "^card\\.[a-z][a-z0-9_]*$"
        },
        "effect_id": {
          "type": "string",
          "pattern": "^effect\\.[a-z][a-z0-9_]*$"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "beneficiary": {
          "enum": [
            "US",
            "USSR"
          ]
        },
        "target_region_id": {
          "type": "string",
          "pattern": "^region\\.[a-z][a-z0-9_]*$"
        },
        "source_refs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "source_id": {
                "type": "string",
                "minLength": 1
              },
              "locator": {
                "type": "string",
                "minLength": 1
              },
              "verification": {
                "enum": [
                  "Verified",
                  "Pending",
                  "Fixture"
                ]
              }
            },
            "required": [
              "source_id",
              "locator",
              "verification"
            ]
          },
          "minItems": 1,
          "description": "逐项资料定位；Fixture不可作为正式规则证据。"
        },
        "template": {
          "const": "ChooseOneInfluenceBranch"
        },
        "branches": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "remove_us": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "description": {
                  "type": "string",
                  "minLength": 1
                },
                "template": {
                  "const": "RemoveAllFromDistinctCountries"
                },
                "target_count": {
                  "type": "integer",
                  "minimum": 1
                },
                "affected_side": {
                  "enum": [
                    "US",
                    "USSR"
                  ]
                },
                "selection_policy": {
                  "const": "AnyRegionCountry"
                }
              },
              "required": [
                "description",
                "template",
                "target_count",
                "affected_side",
                "selection_policy"
              ]
            },
            "add_ussr": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "description": {
                  "type": "string",
                  "minLength": 1
                },
                "template": {
                  "const": "AllocateInfluenceBudget"
                },
                "total_amount": {
                  "type": "integer",
                  "minimum": 1
                },
                "max_per_country": {
                  "type": "integer",
                  "minimum": 1
                },
                "target_control": {
                  "const": "Any"
                },
                "affected_side": {
                  "enum": [
                    "US",
                    "USSR"
                  ]
                }
              },
              "required": [
                "description",
                "template",
                "total_amount",
                "max_per_country",
                "target_control",
                "affected_side"
              ]
            }
          },
          "required": [
            "remove_us",
            "add_ussr"
          ]
        }
      },
      "required": [
        "card_id",
        "effect_id",
        "description",
        "beneficiary",
        "target_region_id",
        "source_refs",
        "template",
        "branches"
      ]
    }
  },
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "dataset_id": {
      "const": "effects.deluxe2015.alliance_prerequisites"
    },
    "content_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "ruleset_id": {
      "type": "string",
      "pattern": "^ruleset\\.[a-z][a-z0-9_]*(\\.[a-z0-9_]+)*$"
    },
    "scope": {
      "enum": [
        "fixture",
        "release-candidate"
      ]
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "source_catalog": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": [
              "string",
              "null"
            ]
          },
          "edition": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "url",
          "edition",
          "description"
        ]
      },
      "minItems": 1
    },
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "marshall_plan": {
          "$ref": "#/$defs/AddToDistinctNonOpponentControlledCountries"
        },
        "warsaw_pact_formed": {
          "$ref": "#/$defs/ChooseOneInfluenceBranch"
        }
      },
      "required": [
        "marshall_plan",
        "warsaw_pact_formed"
      ]
    },
    "completion_policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1
        },
        "template": {
          "const": "RecordCommittedEventFact"
        },
        "fact_policy_ref": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "dataset_id": {
              "type": "string"
            },
            "json_pointer": {
              "type": "string",
              "pattern": "^/"
            }
          },
          "required": [
            "dataset_id",
            "json_pointer"
          ]
        }
      },
      "required": [
        "description",
        "template",
        "fact_policy_ref"
      ]
    }
  },
  "required": [
    "schema_version",
    "dataset_id",
    "content_version",
    "ruleset_id",
    "scope",
    "description",
    "source_catalog",
    "parameters",
    "completion_policy"
  ]
}
