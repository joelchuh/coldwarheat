          "const": "None"
        },
        "track_dataset_id": {
          "const": "rules.deluxe2015.space-race"
        },
        "victory_dataset_id": {
          "const": "rules.deluxe2015.victory"
        },
        "reward_policy": {
          "const": "DestinationOnlyNormalFirstOrSecond"
        },
        "intermediate_reward_policy": {
          "const": "SuppressVpAndRecordReach"
        },
        "ability_policy": {
          "const": "QueryAuthoritativeFinalTrackPositions"
        },
        "overflow_policy": {
          "const": "RequiresRulingBeforeMutation"
        },
        "state_validation_policy": {
          "const": "ValidatePositionsAttemptsTurnAndArrivalEvidenceBeforeMutation"
        },
        "idempotency_policy": {
          "const": "FullRequestDigestAndSourceFrame"
        },
        "proposal_policy": {
          "const": "ImmutableCompletePlanBeforeCommit"
        },
        "root_slot_policy": {
          "const": "NoNewRootSlot"
        },
        "terminal_policy": {
          "const": "FinalizeAcceptedWorkInWinningTransactionThenFinishedAbsorbing"
        },
