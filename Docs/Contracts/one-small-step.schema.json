  "description": "一小步：落后门禁、事件推进两格、仅目标格VP、共享领先能力与越终点待裁定。",
  "$defs": {
    "one_small_step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "card_id",
        "effect_id",
        "description",
        "template",
        "beneficiary",
        "activation_gate",
        "advance_steps",
