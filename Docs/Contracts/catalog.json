{
  "schema_version": 1,
  "description": "先按description定位地图、卡牌、效果参数、开局、布局、主题与规则包契约；Schema不替代语义、资料和运行验证。",
  "status": "design-contracts",
  "entries": [
    {
      "id": "urn:coldwarheat:contract:map:1",
      "description": "规则地图契约v1：地区、国家、超级大国和无向邻接；不含坐标、美术或当前影响力。",
      "status": "schema-defined",
      "path": "Docs/Contracts/map.schema.json"
    },
    {
      "id": "urn:coldwarheat:contract:cards:1",
      "description": "卡牌定义与效果绑定契约v1：印刷事实、类型和参数引用；效果代码仅通过显式注册表绑定。",
      "status": "schema-defined",
      "path": "Docs/Contracts/cards.schema.json"
    },
    {
      "id": "urn:coldwarheat:contract:map-layout:1",
      "description": "视觉布局契约v1：节点位置、拾取形状和连线绘制；不声明新的规则邻接。",
      "status": "schema-defined",
      "path": "Docs/Contracts/layout.schema.json"
    },
    {
      "id": "urn:coldwarheat:contract:theme:1",
      "description": "主题资源契约v1：外观资源和展示回退；不影响地图规则、布局选择或卡牌效果。",
      "status": "schema-defined",
      "path": "Docs/Contracts/theme.schema.json"
    },
    {
      "id": "urn:coldwarheat:contract:ruleset-manifest:1",
      "description": "规则包清单契约v1：固定数据版本、内容摘要及覆盖审核；排除主题资源。Schema通过不代表完整规则可开局。",
      "status": "schema-defined",
      "path": "Docs/Contracts/manifest.schema.json"
    },
    {
      "id": "urn:coldwarheat:contract:cards:2",
      "description": "卡牌定义v2：显式区分参数未解析、确认无参数和已绑定；Unresolved只供整理，不可启动对局。",
      "status": "schema-defined",
      "path": "Docs/Contracts/cards-v2.schema.json"
    },
    {
      "id": "urn:coldwarheat:contract:setup:1",
      "description": "基础开局定义v1：有序部署、固定影响力、自由部署范围与共享初值引用；跨文件规则需另作语义校验。",
      "status": "schema-defined",
      "path": "Docs/Contracts/setup.schema.json"
    },
    {
      "id": "urn:coldwarheat:contract:early-influence-parameters:1",
      "description": "早期影响力第一批参数v1：四种封闭的参数形状；未知字段/操作拒绝，JSON不保存可执行步骤。",
      "status": "schema-defined",
      "path": "Docs/Contracts/early-influence-parameters.schema.json"
    },
    {
      "id": "urn:coldwarheat:contract:early-influence-batch2:1",
      "description": "影响力移除第二批参数v1：封闭的额度移除与按当前时代逐国移除契约；短缺策略按用户确认的项目解释绑定。",
      "status": "schema-defined",
      "path": "Docs/Contracts/early-influence-batch2.schema.json"
    },
    {
      "id": "urn:coldwarheat:contract:early-influence-batch3:1",
      "description": "影响力第三批参数v1：名单内仅增加至追平，以及排除敌控的不同国家放置；封闭字段，不支持任意指令。",
      "status": "schema-defined",
      "path": "Docs/Contracts/early-influence-batch3.schema.json"
    },
    {
      "id": "urn:coldwarheat:contract:persistent-effects-batch1:1",
      "description": "首批持续效果参数契约；固定模板、明确期限、修正类型及封闭字段；不支持任意脚本。",
      "status": "schema-defined",
      "path": "Docs/Contracts/persistent-effects-batch1.schema.json"
    },
    {
      "id": "urn:coldwarheat:contract:treaty-protection:1",
      "description": "条约保护参数契约：显式前置成功事件、永久期限、动态控制/指定国家、具名操作和例外；封闭字段。",
      "status": "schema-defined",
      "path": "Docs/Contracts/treaty-protection.schema.json"
    },
    {
      "id": "urn:coldwarheat:contract:alliance-prerequisites:1",
      "description": "北约两前置卡的类型化影响力契约：不同国家放置、互斥分支、额度/每国上限与成功事实引用；不允许任意指令。",
      "status": "schema-defined",
      "path": "Docs/Contracts/alliance-prerequisites.schema.json"
    },
    {
      "id": "urn:coldwarheat:contract:nato-exceptions:1",
      "description": "两牌固定国家组合事件、封闭步骤原语、持久局部例外与取消/阻止引用；禁止任意脚本或自报取消来源。",
      "status": "schema-defined",
      "path": "Docs/Contracts/nato-exceptions.schema.json"
    },
    {
      "id": "urn:coldwarheat:contract:event-operations-batch1:1",
      "description": "封闭类型化契约，参数只声明已核实能力；不包含可执行表达式或玩家自报授权。",
      "status": "schema-defined",
      "path": "Docs/Contracts/event-operations-batch1.schema.json"
    },
    {
      "id": "urn:coldwarheat:contract:war-events-batch1:1",
      "description": "封闭模板参数，仅三张已核实战争；无任意表达式。",
      "status": "schema-defined",
      "path": "Docs/Contracts/war-events-batch1.schema.json"
    },
    {
      "id": "urn:coldwarheat:contract:war-events-batch2:1",
      "description": "封闭的战争目标/北约引用及Brush三项政策差异；无任意表达式。",
      "status": "schema-defined",
      "path": "Docs/Contracts/war-events-batch2.schema.json"
    },
    {
      "id": "urn:coldwarheat:contract:war-card-hooks:1",
      "description": "具名封闭步骤、已核实五牌集合及显式待裁定边界；禁止任意表达式、默认时序与控制者伪装。",
      "status": "schema-defined",
      "path": "Docs/Contracts/war-card-hooks.schema.json"
    },
    {
      "id": "urn:coldwarheat:contract:defcon-events-batch1:1",
      "description": "四牌封闭参数：按原因/Actor免除降级，危机先终局，解除支付和公共牌区/授权范围明确。",
      "status": "schema-defined",
      "path": "Docs/Contracts/defcon-events-batch1.schema.json"
    },
    {
      "id": "urn:coldwarheat:contract:influence-relocation:1",
      "description": "固定苏联、最多总额与目的上限，封闭目标查询，守恒及重叠待裁定。",
      "status": "schema-defined",
      "path": "Docs/Contracts/influence-relocation.schema.json"
    }
  ]
}
