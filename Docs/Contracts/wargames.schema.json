        "receipt_digest"
      ],
      "properties": {
        "command_id": {
          "type": "string",
          "minLength": 1
        },
        "resolution_id": {
          "type": "string",
          "minLength": 1
        },
        "source_context_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "original_request_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "before_state_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "receipt_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  }
