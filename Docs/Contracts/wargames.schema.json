        "source_context_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "original_request_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "before_state_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "result": {
