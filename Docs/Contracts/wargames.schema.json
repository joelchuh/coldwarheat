          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "accepted_anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command_id",
        "resolution_id",
        "source_context_digest",
        "original_request_digest",
