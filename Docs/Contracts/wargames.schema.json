            "USSR"
          ]
        },
        "vp_delta": {
          "type": "integer"
        },
        "winner": {
          "enum": [
            null,
            "US",
            "USSR"
          ]
        },
        "finish_reason": {
          "enum": [
            null,
            "AutomaticVp",
            "Wargames"
          ]
        },
        "source_disposition": {
          "enum": [
            "DiscardPile",
            "RemovedFromGame"
          ]
        },
        "trace": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "after": {
          "$ref": "#/$defs/snapshot"
        }
