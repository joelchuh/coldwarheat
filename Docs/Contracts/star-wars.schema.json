    "protocol": {
      "const": {
        "description": "Serial Begin -> Select -> ChildReceipt; completed blocked or empty Begin skips child. Child execution and parent cleanup share one accepted completion transaction.",
        "version": 1,
        "history": "BeginHasNoPredecessor; later commands name exact accepted predecessor; same command identity/content returns original accepted result without current-view refresh or current-state overwrite",
        "binding_fields": [
          "command_id",
          "nonce",
          "authenticated_principal",
          "role",
          "source_digest",
          "expected_version",
          "sequence",
          "previous_command_id",
          "before_hash",
          "after_hash",
          "root_slot",
          "root_phasing_player",
          "parent_frame_id",
          "parent_resolution_id",
          "child_frame_id",
          "child_resolution_id",
          "source_instance_id",
          "selected_instance_id",
          "route",
          "provider_id",
          "parameter_digest",
          "reference_digest",
          "actual_card_user"
        ],
        "callback_failure": "KeepAlreadyAcceptedAwaitingChildStateAndEarlierReceipts",
        "terminal": "Accept verified terminal child evidence in completion transaction; close root and skip remaining parent OPS; global Finished/Draw historical replay allowed; Active/Running with any winner rejected",
        "terminal_model_limit": "Protocol-only terminal fixture exercises receipt and cleanup; no admitted target row may generate terminal, Wargames is Pending"
      }
    },
    "privacy": {
      "const": {
        "description": "Discard cards and accepted selection are public; only US receives selectable action authorization. Raw receipts, deck order, source credentials, private hands and independent proof anchors stay authority-only.",
