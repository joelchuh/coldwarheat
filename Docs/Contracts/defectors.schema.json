        },
        {
          "id": "R2015",
          "url": "https://www.gmtgames.com/nnts/TS_Rules-2015.pdf",
          "edition": "Deluxe rules 2015",
          "description": "Sections 4.5C, 5.2, 6.4.5, 10.2-10.3: ordinary headline ordering, opponent-event controller and order, no event from Space, complete VP batch automatic victory."
        },
        {
          "id": "PROJECT-DF1",
