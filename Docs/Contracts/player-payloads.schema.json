{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coldwarheat.local/contracts/player-payloads.schema.json",
  "title": "Player payload file mapping",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "dataset_id",
    "description",
    "entries"
  ],
  "properties": {
    "schema_version": {
      "const": 1,
      "type": "integer"
    },
    "dataset_id": {
      "const": "workflow.player_payloads"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source",
          "destination"
        ],
        "properties": {
          "source": {
            "type": "string",
            "minLength": 1
          },
          "destination": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
