  ],
  "stop_conditions": [
    "待决策不能越过下一回合/最终计分",
    "对方身份、非法候选、陈旧绑定、重复已决策、新版本/序号溢出拒绝",
    "计分牌扣留已终局时无弃牌选择；中国牌不在候选"
  ],
