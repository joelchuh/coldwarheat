{
  "schema_version": 1,
  "description": "按 description 选择设计模块；planned 条目尚不可执行。",
  "entries": [
    {
      "id": "module.turn-flow",
      "description": "定位回合阶段、秘密头条、行动名额、出牌结算栈、回合末候选胜利与存档继续位置；当前是设计，不可作为已实现模块调用。",
      "status": "planned",
      "descriptor": "Docs/Descriptors/turn-flow.module.json"
    },
    {
      "id": "module.defcon",
      "description": "查询政变/调整地理门禁、生成DEFCON变更和核战责任信号；只读设计契约，尚不可调用。",
      "status": "planned",
      "descriptor": "Docs/Descriptors/defcon.module.json"
    },
    {
      "id": "module.military-operations",
      "description": "定位军事行动信用、双方缺额净结算与归零快照；用于防止重复记账和逐方早判胜，尚不可调用。",
      "status": "planned",
      "descriptor": "Docs/Descriptors/military-operations.module.json"
    },
    {
      "id": "module.victory",
      "description": "按检查点判定核战、批次VP、扣留计分牌和最终胜负；CF-003已采纳，模块仍未实现。",
      "status": "planned",
      "descriptor": "Docs/Descriptors/victory.module.json"
    },
    {
      "id": "module.region-scoring",
      "description": "查询六地区档位、东南亚权重和完整最终汇总；纯规则服务设计，尚不可调用。",
      "status": "planned",
      "descriptor": "Docs/Descriptors/region-scoring.module.json"
    },
    {
      "id": "module.space-race",
      "description": "查询8格太空尝试、先后奖励、领先能力、事件推进与回合衔接；当前为设计，尚不可调用。",
      "status": "planned",
      "descriptor": "Docs/Descriptors/space-race.module.json"
    },
    {
      "id": "module.map-data",
      "description": "查询规则地区、国家、超级大国和无向邻接的数据契约与校验边界；不涉及地图坐标或画风，Core尚未实现。",
      "status": "planned",
      "descriptor": "Docs/Descriptors/map-data.module.json"
    },
    {
      "id": "module.card-data",
      "description": "查询三类卡牌静态定义、效果注册、共享参数引用与正式目录审核；不含卡牌美术或已实现的逐卡效果。",
      "status": "planned",
      "descriptor": "Docs/Descriptors/card-data.module.json"
    },
    {
      "id": "module.setup",
      "description": "开局状态机：先发牌查看手牌，按顺序固定布置与自由部署，幂等进入首回合；不引用Unity或画风。",
      "status": "planned",
      "descriptor": "Docs/Descriptors/setup.module.json"
    },
    {
      "id": "module.influence-events",
      "description": "影响力增减/追平/控制筛选与迁移选择；额度、守恒及可恢复决策，13牌已知参数Bound，C#待实现。",
      "status": "planned",
      "descriptor": "Docs/Descriptors/influence-events.module.json"
    },
    {
      "id": "module.active-effects",
      "description": "持续效果生命周期、OPS报价、永久禁止及CardUse处罚实例；计划结果只由编排事务提交。",
      "status": "planned",
      "descriptor": "Docs/Descriptors/active-effects.module.json"
    },
    {
      "id": "module.action-restrictions",
      "description": "查询条约保护与前置条件，组合DEFCON和基础目标合法性；动态重查控制权并返回具名阻止原因，尚无C#实现。",
      "status": "planned",
      "descriptor": "Docs/Descriptors/action-restrictions.module.json"
    },
    {
      "id": "module.composite-events",
      "description": "固定组合事件与可选区域行动：影响力、VP、成功事实、永久取消阻止和授权子帧；封闭步骤，终局截断。",
      "status": "planned",
      "descriptor": "Docs/Descriptors/composite-events.module.json"
    },
    {
      "id": "module.event-operations",
      "description": "事件OPS子上下文：固定美国地区免费行动或中立视同OPS普通行动；来源独立验证、按Actor修正、单根名额与原核战责任。",
      "status": "planned",
      "descriptor": "Docs/Descriptors/event-operations.module.json"
    },
    {
      "id": "module.war-events",
      "description": "五张战争事件服务：选择被攻击国、稳定度与北约门禁、单骰及直接超级大国修正、固定军事/VP和影响力转移；不借用政变算法。",
      "status": "planned",
      "descriptor": "Docs/Descriptors/war-events.module.json"
    },
    {
      "id": "module.card-play-hooks",
      "description": "实际CardUse资格与持续处罚：区分CardPlayer/根行动者/事件控制者；不响应抽牌或显示，未裁定时序与来源停止。",
      "status": "planned",
      "descriptor": "Docs/Descriptors/card-play-hooks.module.json"
    },
    {
      "id": "module.coup-interventions",
      "description": "政变前干预与危机解除：以实际Actor判致命危机、核潜艇按原因豁免、SALT骰修正；纯计划不改状态。",
      "status": "planned",
      "descriptor": "Docs/Descriptors/coup-interventions.module.json"
    },
    {
      "id": "module.hand-events",
      "description": "手牌事件服务：私有阈值候选/弃牌、随机单牌收据与US事件子帧路由；不负责直接执行子牌事件或修改玩家快照。",
      "status": "planned",
      "descriptor": "Docs/Descriptors/hand-events.module.json"
    }
  ]
}
