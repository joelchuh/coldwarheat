      "symbol": "TurnDealPlan"
    }
  ],
  "inputs": [
    "经审核CardCatalog与完整CardZones",
    "可信TurnStart的GameTurnContext、显式IRandomProvider；HandTarget来自共享日历"
  ],
  "outputs": [
    "权威私有TurnDealPlan：Before/Cards/Turn/Random、双方补牌数、时代加入标志和弃牌重洗数"
  ],
  "dependencies": [
    "module.card-zones",
