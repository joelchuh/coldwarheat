{
  "schema_version": 1,
  "id": "module.influence-event-sessions",
  "kind": "module",
  "description": "同一GameState中的一次性影响力事件与受益方选择：支持国家集合和数量分配，公开容量由核心计算；固定身份、版本和同一收据表原子提交。数量UI已接入九练习Demo，正式出牌/牌区/回合未实现。 东欧动荡复用国家集合，时代由宿主Turn决定；缺失回合有具名拒绝。",
  "status": "implemented",
  "entrypoints": [
    {
      "path": "Assets/ColdWarStruggle/Scripts/Core/Effects/InfluenceEventFlow.cs",
      "symbol": "Begin"
    },
    {
      "path": "Assets/ColdWarStruggle/Scripts/Core/Effects/InfluenceEventFlow.cs",
      "symbol": "Resolve"
    },
    {
      "path": "Assets/ColdWarStruggle/Scripts/Core/Effects/InfluenceEventFlow.cs",
      "symbol": "QueryDecision"
    },
    {
      "path": "Assets/ColdWarStruggle/Scripts/Application/Sessions/SessionContracts.cs",
      "symbol": "SubmitEventAsync"
    },
    {
      "path": "Assets/ColdWarStruggle/Scripts/Application/Sessions/SessionContracts.cs",
      "symbol": "QueryEventTargets"
    },
    {
      "path": "Assets/ColdWarStruggle/Scripts/Core/Effects/InfluenceEventFlow.cs",
      "symbol": "ResolveAllocation"
    },
    {
      "path": "Assets/ColdWarStruggle/Scripts/Application/Sessions/EventSessionContracts.cs",
      "symbol": "Allocate"
    }
  ],
  "inputs": [
    "可信初始GameState中已授权且公开的InfluenceEventExecution",
    "固定身份会话；EventCommandEnvelope含GameId/ExpectedVersion/ExecutionId/DecisionId及完整国家集合或CountryId/Amount分配；不接受Owner和规则额度"
  ],
  "outputs": [
    "新玩家视图、只读候选/Kind/容量/有效总量、完成或请求序号、幂等事件收据"
  ],
  "dependencies": [
    "module.influence-event-planners",
    "module.local-session"
  ],
  "preconditions": [
    "实例由可信装配器加载；玩家不能指定效果/受益方/数值",
    "仅一项事件继续状态；完整父子出牌结算栈待实现",
    "时代事件必须由可信宿主提供GameTurnContext，客户端不能自报时代"
  ],
  "side_effects": [
    "成功命令在同一宿主锁内替换权威状态并记收据；纯Core方法只返回隔离结果"
  ],
  "stop_conditions": [
    "未知政策或短缺待裁定、禁止事件、错误身份/版本/实例/决策、数值溢出",
    "未完成事件阻止普通OPS；同身份同命令ID改类型或payload冲突",
    "分配金额/国家/顺序/kind改变但复用同ID冲突；未知种类、混合载荷、空/超128条格式拒绝且不记收据"
  ],
  "rule_sources": [
    {
      "path": "Docs/Wiki/early-influence-batch1.md",
