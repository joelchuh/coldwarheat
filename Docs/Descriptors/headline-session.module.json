  "status": "implemented-subset",
  "description": "头条收集、可选回合入口与固定身份会话已实现：秘密过滤、共享幂等、只读观察和有界公开结算摘要；等待选择继续接线待完成，UI未启用。",
  "entrypoints": [
    {
      "path": "Assets/ColdWarStruggle/Scripts/Core/Rules/HeadlineFlowRules.cs",
      "symbol": "BeginCollection"
    },
    {
      "path": "Assets/ColdWarStruggle/Scripts/Core/Rules/HeadlineFlowRules.cs",
      "symbol": "Submit"
    },
    {
      "path": "Assets/ColdWarStruggle/Scripts/Application/Sessions/SessionContracts.cs",
      "symbol": "SubmitHeadlineAsync"
    },
    {
      "path": "Assets/ColdWarStruggle/Scripts/Application/Sessions/HeadlineSessionContracts.cs",
      "symbol": "HeadlineCommand"
    }
  ],
  "inputs": [
    "可信ActionPracticeDefinition.HeadlineParameters；null保持旧试玩",
    "固定身份门禁后的权威GameState/PlayerSide/CardId"
  ],
  "outputs": [
    "不可变HeadlineResolutionTransition；失败无NextState/Steps",
    "第二次选齐自动结算至等待/终局/普通行动",
    "公开HeadlineCommandResult/View/Steps；无原始GameState/牌库/RNG",
    "本地只读观察可显式查看ReservedHeadlines，正常视图过滤私有牌"
  ],
  "dependencies": [
    "module.headline-foundation",
    "module.headline-resolution"
  ],
  "data_dependencies": [
    "rules.deluxe2015.turn-flow"
  ],
  "preconditions": [
    "只接受尚未开始普通行动的收集状态",
    "选择和GameState使用同一CardZones引用，目录须同一实例"
  ],
  "side_effects": [
    "纯服务返回草稿；旧Demo工厂未启用",
    "初始/下一回合可选进入收集，复用原发牌准备且不二次补牌",
    "Host共用gate和所有命令的收据字典；同内容返回历史结果不回写当前状态；过期拒绝缓存，须新ID重试"
  ],
  "stop_conditions": [
    "无处理器候选保持收集，不自动跳过",
    "错身份/牌/重复/阶段/溢出拒绝，首张已提交锁牌前缀不变"
  ],
  "rule_sources": [
