{
  "schema_version": 1,
  "id": "module.local-session",
  "kind": "module",
  "description": "同一权威局面的美苏固定身份会话；普通影响力与事件命令共用身份收据，版本/上下文/决策校验，公开事件投影与显式测试观察。",
  "status": "implemented",
  "entrypoints": [
    {
      "path": "Assets/ColdWarStruggle/Scripts/Application/Sessions/LocalGameHost.cs",
      "symbol": "LocalGameHost"
    },
    {
      "path": "Assets/ColdWarStruggle/Scripts/Application/Sessions/SessionContracts.cs",
      "symbol": "IGameSession"
    },
    {
      "path": "Assets/ColdWarStruggle/Scripts/Application/Sessions/LocalGameHost.cs",
      "symbol": "ReadLocalTestSnapshot"
    }
  ],
  "inputs": [
    "可信初始GameState、显式localTest开关、CommandEnvelope",
    "预装事件实例及EventCommandEnvelope，玩家不能上传效果定义"
  ],
  "outputs": [
    "过滤的PlayerViewSnapshot、收据、LegalTargetsResult；授权观察入口可读双方示例手牌",
    "公开只读GameTurnContext；旧fixture无回合时为null"
  ],
  "dependencies": [
    "module.influence-core"
  ],
  "preconditions": [
    "单进程可信Bootstrap；不是联网身份认证"
  ],
  "side_effects": [
    "接受命令原子替换局面并保存内存收据；重试不重放效果"
  ],
  "stop_conditions": [
    "错误身份/版本/上下文/同ID不同payload；未开启localTest禁止观察",
    "GameState.Deployment存在时拒绝普通OPS/事件；部署完成后的正式阶段交接另行实现。"
  ],
  "rule_sources": [
    {
      "path": "Docs/Wiki/operations.md",
