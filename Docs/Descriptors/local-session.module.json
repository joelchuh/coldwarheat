{
  "schema_version": 1,
  "id": "module.local-session",
  "kind": "module",
  "description": "同一权威局面的美苏固定身份会话；命令版本/上下文校验、按身份幂等、只读玩家投影和显式本地测试观察。",
  "status": "implemented",
  "entrypoints": [
    {
      "path": "Assets/ColdWarStruggle/Scripts/Application/Sessions/LocalGameHost.cs",
      "symbol": "LocalGameHost"
    },
    {
      "path": "Assets/ColdWarStruggle/Scripts/Application/Sessions/SessionContracts.cs",
      "symbol": "IGameSession"
    },
    {
      "path": "Assets/ColdWarStruggle/Scripts/Application/Sessions/LocalGameHost.cs",
      "symbol": "ReadLocalTestSnapshot"
    }
  ],
  "inputs": [
    "可信初始GameState、显式localTest开关、CommandEnvelope"
  ],
  "outputs": [
    "过滤的PlayerViewSnapshot、收据、LegalTargetsResult；授权观察入口可读双方示例手牌"
  ],
  "dependencies": [
    "module.influence-core"
  ],
