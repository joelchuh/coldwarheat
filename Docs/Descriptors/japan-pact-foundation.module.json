  ],
  "data_dependencies": [
    "effects.deluxe2015.treaty_protection",
    "cards.deluxe2015.definitions",
    "map.deluxe2015.world"
  ],
  "preconditions": [
    "使用权威单调状态版本；永久实例与加点/牌去向必须由后续宿主原子提交；NoTreatyBlock不是整体合法性"
  ],
  "side_effects": [
    "只返回不可变候选与只读查询；不直接提交GameState、消耗随机数或修改UI"
