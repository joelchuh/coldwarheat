  "status": "implemented",
  "description": "美日安保基础：通用补足控制影响力、严格条约参数装载、不可变永久状态候选及实际Actor保护查询；真实出牌与跨回合宿主见module.japan-pact-play。",
  "documentation": "Docs/Wiki/japan-pact-foundation.md",
  "entrypoints": [
    {
      "path": "Assets/ColdWarStruggle/Scripts/Core/Effects/AddToControlInfluenceEffect.cs",
      "symbol": "AddToControlInfluenceEffect"
    },
    {
      "path": "Assets/ColdWarStruggle/Scripts/Infrastructure/DataLoading/JapanPactDefinitionLoader.cs",
      "symbol": "Load"
    },
    {
      "path": "Assets/ColdWarStruggle/Scripts/Core/Rules/JapanPactState.cs",
      "symbol": "Activate"
    },
    {
      "path": "Assets/ColdWarStruggle/Scripts/Core/Rules/JapanPactRules.cs",
      "symbol": "Evaluate"
    }
  ],
  "inputs": [
    "正式0.1.0条约参数及schema、同一MapDefinition/CardCatalog；权威GameState、gameId、事件控制者/实际行动者、结算ID和操作/目标"
  ],
  "outputs": [
    "AddToControl影响力事务候选；带参数摘要/源序号的永久条约候选；NoTreatyBlock/BlockedByTreaty/InvalidContext"
  ],
  "dependencies": [
    "Assets/ColdWarStruggle/Scripts/Core/Effects/InfluenceEventRules.cs",
