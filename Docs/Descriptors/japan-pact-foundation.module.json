  "stop_conditions": [
    "未知参数/绑定/来源/Actor/操作；地图或game不匹配、开局/终局、溢出、同ID冲突或新ID重复激活"
  ],
  "rule_sources": [
    {
      "path": "Docs/Wiki/treaty-protection.md",
      "scope": "GMT Deluxe #27及R2015 §2.1.7/§7.3；无新增解释"
    }
  ],
  "tests": [
    {
      "path": "Assets/ColdWarStruggle/Tests/EditMode/JapanPactFoundationTests.cs",
      "status": "passed"
    }
  ],
  "verification": {
    "report": "Docs/Testing/japan-pact-foundation.validation.json",
    "native_editmode_passed": 3902
  },
  "flow": [
    "正式JSON→严格Loader→有界Definition",
    "AddToControl→InfluenceEventRules/Flow→私有候选",
    "JapanPactState.Activate→永久状态候选",
    "Evaluate→条约门禁；基础/DEFCON/预算须另外验证"
  ]
