      "description": "拒绝重复国家ID",
      "dataset": "map",
      "validation_layer": "data",
      "edits": [
        {
          "op": "replace",
          "path": [
            "countries",
            1,
            "id"
          ],
          "value": "country.canada"
        }
      ],
      "expected_valid": false,
      "status": "specified"
    },
    {
